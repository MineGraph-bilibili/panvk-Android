#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InBuf {
    uint data[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutBuf {
    uint data[];
};

layout(push_constant) uniform Registers
{
    uvec2 src;
    uvec2 dst;
    uint src_row_B;
    uint src_slice_B;
    uint dst_row_B;
    uint dst_slice_B;
    int width;
    int height;
    int depth;
    int format;
    uint dst_x0;    /* region origin in decoded elements, tiled planes only */
    uint dst_y0;
    uint dst_tiled;
} registers;

/* Byte offset of element (x, y) in a U-interleaved plane: tiles of 2^t_log2
 * elements square (4x4 ASTC blocks, 16x16 R8/RG8 texels) in row-major
 * order; inside a tile bit 2k of the index is x_k ^ y_k and bit 2k+1 is y_k. */
uint spread4(uint v)
{
    v = (v | (v << 2u)) & 0x33u;
    return (v | (v << 1u)) & 0x55u;
}

uint utile_offset_B(uint x, uint y, uint t_log2, uint elem_B)
{
    uint m = (1u << t_log2) - 1u;
    uint sy = spread4(y & m);
    uint idx = (sy | (sy << 1u)) ^ spread4(x & m);
    return (y >> t_log2) * registers.dst_row_B +
           (x >> t_log2) * (elem_B << (2u * t_log2)) + idx * elem_B;
}

layout(constant_id = 0) const int SPEC_FORMAT = 0;

#define VK_FORMAT_BC1_RGB_UNORM_BLOCK 131
#define VK_FORMAT_BC1_RGB_SRGB_BLOCK 132
#define VK_FORMAT_BC1_RGBA_UNORM_BLOCK 133
#define VK_FORMAT_BC1_RGBA_SRGB_BLOCK 134
#define VK_FORMAT_BC2_UNORM_BLOCK 135
#define VK_FORMAT_BC2_SRGB_BLOCK 136
#define VK_FORMAT_BC3_UNORM_BLOCK 137
#define VK_FORMAT_BC3_SRGB_BLOCK 138
#define VK_FORMAT_BC4_UNORM_BLOCK 139
#define VK_FORMAT_BC4_SNORM_BLOCK 140
#define VK_FORMAT_BC5_UNORM_BLOCK 141
#define VK_FORMAT_BC5_SNORM_BLOCK 142

/* BC4/BC5 UNORM channel as an exact 8-bit value (D3D palette rounding). */
uint decode_rgtc_unorm8(uvec2 payload, int linear_pixel)
{
	uint a0 = payload.x & 0xffu, a1 = (payload.x >> 8) & 0xffu;
	int bit_offset = 16 + linear_pixel * 3;
	uint k;
	if (bit_offset <= 29)
		k = bitfieldExtract(payload.x, bit_offset, 3);
	else if (bit_offset >= 32)
		k = bitfieldExtract(payload.y, bit_offset - 32, 3);
	else
		k = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3u) << 1);

	if (k < 2u)
		return k != 0u ? a1 : a0;
	if (a0 > a1)
		return ((a0 * (8u - k) + a1 * (k - 1u) + 3u) * 9363u) >> 16u;
	if (k > 5u)
		return k == 6u ? 0u : 255u;
	return ((a0 * (6u - k) + a1 * (k - 1u) + 2u) * 13108u) >> 16u;
}

float decode_alpha_rgtc(uvec2 payload, int linear_pixel)
{
	float ep0 = float(int(payload.x & 0xffu)) / 255.0;
	float ep1 = float(((payload.x >> 8) & 0xffu)) / 255.0;
	bool range7 = ep0 > ep1;

	int bit_offset = 16 + linear_pixel * 3;
	uint bits;
	if (bit_offset <= 29)
		bits = bitfieldExtract(payload.x, bit_offset, 3);
	else if (bit_offset >= 32)
		bits = bitfieldExtract(payload.y, bit_offset - 32, 3);
	else
		bits = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);

	float res;
	if (bits < 2)
		res = bits != 0 ? ep1 : ep0;
	else if (range7)
		res = mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
	else if (bits > 5)
		res = float(bits & 1);
	else
		res = mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));

	return res;
}

float decode_alpha_rgtc_snorm(uvec2 payload, int linear_pixel)
{
   float ep0 = max(float(bitfieldExtract(int(payload.x), 0, 8)) / 127.0, -1.0);
   float ep1 = max(float(bitfieldExtract(int(payload.x), 8, 8)) / 127.0, -1.0);
   bool range7 = ep0 > ep1;
   int bit_offset = 16 + linear_pixel * 3;
   uint bits = bit_offset <= 29 ? bitfieldExtract(payload.x, bit_offset, 3) :
               bit_offset >= 32 ? bitfieldExtract(payload.y, bit_offset - 32, 3) :
               bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);
   if (bits < 2)
      return bits != 0 ? ep1 : ep0;
   if (range7)
      return mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
   if (bits > 5)
      return bits == 6 ? -1.0 : 1.0;
   return mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
}

vec3 decode_endpoint_color(uint color)
{
    ivec3 c = ivec3(color) >> ivec3(11, 5, 0);
    c &= ivec3(31, 63, 31);
    return vec3(c) / vec3(31.0, 63.0, 31.0);
}

bool decode_endpoints_color(int format, uint payload, out vec3 ep0, out vec3 ep1)
{
    uint color0 = payload & 0xffffu;
    uint color1 = payload >> 16u;
    bool opaque_mode = (format > VK_FORMAT_BC1_RGBA_SRGB_BLOCK) || (color0 > color1);
    ep0 = decode_endpoint_color(color0);
    ep1 = decode_endpoint_color(color1);
    return opaque_mode;
}

vec4 interpolate_endpoint_color(vec3 ep0, vec3 ep1, int bits, bool opaque_mode)
{
    vec4 res;
    vec3 lerped;
    if (opaque_mode)
    {
        if (bits < 2)
            lerped = bits != 0 ? ep1 : ep0;
        else
            lerped = mix(ep0, ep1, (1.0 / 3.0) * float(bits - 1));
        res = vec4(lerped, 1.0);
    }
    else
    {
        if (bits == 3)
        {
            res = vec4(0.0);
        }
        else
        {
            if (bits == 0)
                lerped = ep0;
            else if (bits == 1)
                lerped = ep1;
            else
                lerped = 0.5 * (ep0 + ep1);
            res = vec4(lerped, 1.0);
        }
    }
    return res;
}

float decode_alpha_4bit(uvec2 payload, int pixel)
{
    uint offset = pixel * 4;
    return float((payload[offset >> 5] >> (offset & 31)) & 0xf) / 15.0;
}


void main()
{
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    uint bz = gl_GlobalInvocationID.z;

    uint num_blocks_x = uint((registers.width + 3) / 4);
    uint num_blocks_y = uint((registers.height + 3) / 4);

    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
        return;

    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);
    int format = SPEC_FORMAT != 0 ? SPEC_FORMAT : registers.format;

    bool two = format == VK_FORMAT_BC5_SNORM_BLOCK || format == VK_FORMAT_BC5_UNORM_BLOCK;
    bool snorm = format == VK_FORMAT_BC4_SNORM_BLOCK || format == VK_FORMAT_BC5_SNORM_BLOCK;
    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * (two ? 4u : 2u);
    uvec2 r_payload = uvec2(ibuf.data[in_word], ibuf.data[in_word + 1u]);
    uvec2 g_payload = two ? uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]) : uvec2(0u);

    uint texel_B = two ? 2u : 1u;
    if (registers.dst_tiled != 0u) {
        /* U-interleaved: a 2x2 quad with even origin is 4 consecutive
         * texels in the order (0,0) (1,0) (1,1) (0,1). The plane is padded
         * to whole 16x16 tiles, so no edge checks are needed. */
        for (uint q = 0u; q < 4u; q++) {
            uint qx = (q & 1u) * 2u, qy = (q >> 1u) * 2u;
            uint base = (bz * registers.dst_slice_B +
                         utile_offset_B(registers.dst_x0 + bx * 4u + qx,
                                        registers.dst_y0 + by * 4u + qy, 4u, texel_B)) / 4u;
            uint words[2] = uint[2](0u, 0u);
            for (uint k = 0u; k < 4u; k++) {
                uint tx = qx + ((k == 1u || k == 2u) ? 1u : 0u);
                uint ty = qy + (k >= 2u ? 1u : 0u);
                int p = int(ty * 4u + tx);
                uint r, g = 0u;
                if (snorm) {
                    r = uint(int(round(clamp(decode_alpha_rgtc_snorm(r_payload, p), -1.0, 1.0) * 127.0)) & 0xff);
                    if (two)
                        g = uint(int(round(clamp(decode_alpha_rgtc_snorm(g_payload, p), -1.0, 1.0) * 127.0)) & 0xff);
                } else {
                    r = decode_rgtc_unorm8(r_payload, p);
                    if (two)
                        g = decode_rgtc_unorm8(g_payload, p);
                }
                if (two)
                    words[k >> 1u] |= (r | (g << 8u)) << (16u * (k & 1u));
                else
                    words[0] |= r << (8u * k);
            }
            obuf.data[base] = words[0];
            if (two)
                obuf.data[base + 1u] = words[1];
        }
        return;
    }

    /* Linear R8/RG8 plane: dst is the region origin texel, dst_row_B the
     * texel row stride (>= 64 B aligned, so whole 4-texel words fit). */
    for (uint row = 0u; row < 4u; row++) {
        if (by * 4u + row >= uint(registers.height))
            break;
        uint base = (bz * registers.dst_slice_B + (by * 4u + row) * registers.dst_row_B +
                     bx * 4u * texel_B) / 4u;
        uint words[2] = uint[2](0u, 0u);
        for (uint x = 0u; x < 4u; x++) {
            int p = int(row * 4u + x);
            uint r, g = 0u;
            if (snorm) {
                r = uint(int(round(clamp(decode_alpha_rgtc_snorm(r_payload, p), -1.0, 1.0) * 127.0)) & 0xff);
                if (two)
                    g = uint(int(round(clamp(decode_alpha_rgtc_snorm(g_payload, p), -1.0, 1.0) * 127.0)) & 0xff);
            } else {
                r = decode_rgtc_unorm8(r_payload, p);
                if (two)
                    g = decode_rgtc_unorm8(g_payload, p);
            }
            if (two)
                words[x >> 1u] |= (r | (g << 8u)) << (16u * (x & 1u));
            else
                words[0] |= r << (8u * x);
        }
        obuf.data[base] = words[0];
        if (two)
            obuf.data[base + 1u] = words[1];
    }
}
