                        bitfieldExtract(p[0], 15, 6),
                        bitfieldExtract(p[0], 25, 6)));
      e[1] = ivec3(uvec3(bitfieldExtract(p[1], 3, 6),
                        bitfieldExtract(p[1], 13, 6),
                        bitfieldExtract(p[1], 23, 6)));
      e[2] = ivec3(uvec3(bitfieldExtract(p[2], 1, 6),
                        (bitfieldExtract(p[0], 21, 1) << 5) | (bitfieldExtract(p[0], 24, 1) << 4) | bitfieldExtract(p[1], 9, 4),
                        (bitfieldExtract(p[0], 14, 1) << 4) | (bitfieldExtract(p[0], 22, 1) << 5) | (bitfieldExtract(p[1], 29, 3) | (bitfieldExtract(p[2], 0, 1) << 3))));
