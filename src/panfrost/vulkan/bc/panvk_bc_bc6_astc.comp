}

/* fp16 bits of texel i (negative values read as +0, as the ASTC HDR
 * target cannot hold them). */
uvec3 bc6_half(uint i)
{
   const uint s = (g6_pm >> i) & 1u;
   const uint k = (g6_ix[i >> 3u] >> (4u * (i & 7u))) & 15u;
   /* BC6H weight tables: 4-bit (17k + 2) >> 2, 3-bit (73k + 4) >> 3 */
   const int w = int((g6_pm >> 16u) != 0u ? (17u * k + 2u) >> 2u : (73u * k + 4u) >> 3u);
   const uvec3 pr = s != 0u ? g6_s1 : g6_s0;
   ivec3 e0, e1;
   if (BC6_SIGNED) {
      e0 = bitfieldExtract(ivec3(pr), 0, 16);
      e1 = ivec3(pr) >> 16;
   } else {
      e0 = ivec3(pr & 0xffffu);
      e1 = ivec3(pr >> 16u);
   }
   ivec3 v = ((64 - w) * e0 + w * e1 + 32) >> 6;
   if (BC6_SIGNED)
      return uvec3((max(v, ivec3(0)) * 31) >> 5);
   return uvec3((v * 31) >> 6);
}

/* ---- BC6H entry: streaming HDR encoder ------------------------------ */

/* Weights 0..11 (trit + 2 bits) by rank k. The unquantised values are
 * symmetric (unq(11 - k) = 64 - unq(k)); ranks 0..5 are 0 5 11 17 23 28,
 * packed 5 bits each. */
float w11_unq(uint k)
{
   const uint c = min(k, 11u - k);
   const uint u = bitfieldExtract(964209824u, int(5u * c), 5);
   return float(k > 5u ? 64u - u : u);
}

/* ISE code of rank k: trit + 2 bits, mirrored ranks differ in bit 0. */
uint w11_ise(uint k)
{
   const uint c = min(k, 11u - k);
   const uint hi = c >= 3u ? 1u : 0u;
   return ((c - 3u * hi) * 4u + hi * 2u) | (k > 5u ? 1u : 0u);
}

/* fp16 bits (non-negative) -> LNS value (0..65535). */
vec3 lns3(uvec3 h)
{
   const vec3 mt = vec3((h & 0x3ffu) << 3u);
   const vec3 m = mix(mix((mt + 2048.0) / 5.0, (mt + 512.0) / 4.0, lessThan(mt, vec3(5632.0))),
                      mt / 3.0, lessThan(mt, vec3(1536.0)));
   return vec3((h >> 10u) << 11u) + m;
}

/* The encoder reads each texel's LNS value on every pass: convert the 16
 * texels once per block into workgroup memory. */
shared uint s6_lns[32u * 64u];

vec3 bc6_lns(uint i)
{
   const uint b = 2u * i * 64u + gl_LocalInvocationIndex;
   const uint rg = s6_lns[b];
   return vec3(float(rg & 0xffffu), float(rg >> 16u), float(s6_lns[b + 64u]));
}

/* CEM 11 values for 12-bit endpoints lo/hi in one of the eight packed
 * modes (0..7) or the direct mode (8). */
void hdr_encode(ivec3 lo, ivec3 hi, uint mode, uint maj, out uint v[6])
{
   if (mode == 8u) {
      /* Direct: 8 bits for red/green, 7 for blue, no range limits. */
      ivec3 l8 = clamp((lo + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
      ivec3 h8 = clamp((hi + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
      v = uint[6](uint(l8.r), uint(h8.r), uint(l8.g), uint(h8.g),
                  uint(l8.b) | 0x80u, uint(h8.b) | 0x80u);
   } else {
      hdr_pack(lo, hi, mode, maj, v);
   }
}

/* Best CEM 11 encoding of endpoints e0/e1 (16-bit LNS, either order).
 * Only the winning mode is kept during the search; it is re-encoded at
 * the end. Returns the six values packed 8 bits each; q0/q1 receive the
 * endpoints the decoder will see. */
uvec2 hdr_quant(vec3 e0, vec3 e1, out vec3 q0, out vec3 q1)
{
   const ivec3 i0 = clamp(ivec3(e0 / 16.0 + 0.5), 0, 4095);
   const ivec3 i1 = clamp(ivec3(e1 / 16.0 + 0.5), 0, 4095);
   /* The decoder's second endpoint holds the overall largest component. */
   const int m0 = max(i0.r, max(i0.g, i0.b)), m1 = max(i1.r, max(i1.g, i1.b));
   const ivec3 lo = m1 >= m0 ? i0 : i1, hi = m1 >= m0 ? i1 : i0;
   const uint maj = hi.r >= hi.g && hi.r >= hi.b ? 0u : (hi.g >= hi.b ? 1u : 2u);

   /* The packed modes store a, b0, b1, c, d0, d1 losslessly once they are
    * clamped to their field widths, so what the decoder will see can be
    * computed directly; only the winner is bit-packed. Error is the same in
    * the major-component order, so search there. */
   ivec3 sl = lo, sh = hi;
   if (maj == 1u) { sl = sl.grb; sh = sh.grb; }
   if (maj == 2u) { sl = sl.bgr; sh = sh.bgr; }
   float be = 1e30;
   uint bm = 0u;
   ivec3 bql = sl, bqh = sh;   /* decoded endpoints of the best mode, major order */
   [[unroll]] for (uint mode = 0u; mode < 8u; mode++) {
      const uint s = (mode >> 1u) ^ 3u;
      const int a = clamp(hdr_q(sh.r, s), 0, (1 << hdr_abits(mode)) - 1);
      const int A = a << s;
      const int bmx = (1 << hdr_bbits(mode)) - 1;
      const int b0 = clamp(hdr_q(A - sh.g, s), 0, bmx) << s;
      const int b1 = clamp(hdr_q(A - sh.b, s), 0, bmx) << s;
      const int c = clamp(hdr_q(A - sl.r, s), 0, (1 << hdr_cbits(mode)) - 1) << s;
      const int db = int(hdr_dbits(mode));
      const int dl = -(1 << (db - 1)), dh = (1 << (db - 1)) - 1;
      const int d0 = clamp(hdr_q(A - b0 - c - sl.g, s), dl, dh) << s;
      const int d1 = clamp(hdr_q(A - b1 - c - sl.b, s), dl, dh) << s;
      const ivec3 qh = clamp(ivec3(A, A - b0, A - b1), 0, 4095);
      const ivec3 ql = clamp(ivec3(A - c, A - b0 - c - d0, A - b1 - c - d1), 0, 4095);
      const vec3 el = vec3(ql - sl), eh = vec3(qh - sh);
      const float e = dot(el, el) + dot(eh, eh);
      if (e < be) { be = e; bm = mode; bql = ql; bqh = qh; }
   }
   {
      /* direct mode */
      const ivec3 l8 = clamp((lo + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
      const ivec3 h8 = clamp((hi + ivec3(8, 8, 16)) >> ivec3(4, 4, 5), ivec3(0), ivec3(255, 255, 127));
      const vec3 el = vec3((l8 << ivec3(4, 4, 5)) - lo), eh = vec3((h8 << ivec3(4, 4, 5)) - hi);
      const float e = dot(el, el) + dot(eh, eh);
      if (e < be) { be = e; bm = 8u; bql = l8 << ivec3(4, 4, 5); bqh = h8 << ivec3(4, 4, 5); }
   }
   uint v[6];
   hdr_encode(lo, hi, bm, maj, v);
   /* The search computed what the decoder returns; the packed modes kept it
    * in major-component order. */
   if (bm != 8u) {
      if (maj == 1u) { bql = bql.grb; bqh = bqh.grb; }
      if (maj == 2u) { bql = bql.bgr; bqh = bqh.bgr; }
   }
   q0 = vec3(bql) * 16.0;
   q1 = vec3(bqh) * 16.0;
   return uvec2(v[0] | (v[1] << 8u) | (v[2] << 16u) | (v[3] << 24u), v[4] | (v[5] << 8u));
}

/* Weight rank (0..11) nearest to x in 0..64: the 12-level weights are
 * 0 5 11 17 23 28 36 41 47 53 59 64; count the midpoints below x. */
uint w11_rank(float x)
{
   const vec4 t0 = vec4(2.5, 8.0, 14.0, 20.0), t1 = vec4(25.5, 32.0, 38.5, 44.0);
   const vec3 t2 = vec3(50.0, 56.0, 61.5);
   const vec4 a = step(t0, vec4(x)), b = step(t1, vec4(x));
   const vec3 c = step(t2, vec3(x));
   return uint(dot(a, vec4(1.0)) + dot(b, vec4(1.0)) + dot(c, vec3(1.0)));
}

/* 16 weight ranks (4 bits each in r) as the ASTC trit + 2-bit stream:
 * 3 groups of 5 values (18 bits) and one value with its 2 trit bits. */
uvec2 ise12_16(uvec2 r)
{
   uvec2 o = uvec2(0u);
   uint off = 0u;
   for (uint g = 0u; g < 4u; g++) {
      uint q[5], t[5];
      for (uint j = 0u; j < 5u; j++) {
         const uint i = 5u * g + j;
         const uint c = i < 16u ? w11_ise((r[i >> 3u] >> (4u * (i & 7u))) & 15u) : 0u;
         q[j] = c & 3u; t[j] = c >> 2u;
      }
      const uint packed = TRIT_PACK[t[0] + 3u * t[1] + 9u * t[2] + 27u * t[3] + 81u * t[4]];
      const uint grp = q[0] | (packed & 3u) << 2u | q[1] << 4u | ((packed >> 2u) & 3u) << 6u |
                       q[2] << 8u | ((packed >> 4u) & 1u) << 10u | q[3] << 11u |
                       ((packed >> 5u) & 3u) << 13u | q[4] << 15u | ((packed >> 7u) & 1u) << 17u;
      const uint n = g < 3u ? 18u : 4u;
      const uint v = grp & ((1u << n) - 1u);
      o.x |= off < 32u ? v << off : 0u;
      o.y |= off == 0u ? 0u : off < 32u ? v >> (32u - off) : v << (off - 32u);
      off += n;
   }
   return o;
}

uvec4 encode_bc6()
{
   /* One pass: cache each texel's LNS value and accumulate the mean and
    * covariance (relative to texel 0, symmetric terms only). */
   const vec3 org = vec3(uvec3(lns3(bc6_half(0u)) + 0.5));
   vec3 sum = vec3(0.0), sq = vec3(0.0), cr = vec3(0.0), lo = org, hi = org;
   [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
      const uvec3 v = uvec3(lns3(bc6_half(i)) + 0.5);
      s6_lns[(2u * i) * 64u + gl_LocalInvocationIndex] = v.r | (v.g << 16u);
      s6_lns[(2u * i + 1u) * 64u + gl_LocalInvocationIndex] = v.b;
      const vec3 p = vec3(v), d = p - org;
      sum += d; sq += d * d; cr += d.xxy * d.yzz;
      lo = min(lo, p); hi = max(hi, p);
   }
   const vec3 mean = org + sum * (1.0 / 16.0);
   const vec3 ms = sum * (1.0 / 16.0);
   const mat3 cov = mat3(sq.x - 16.0 * ms.x * ms.x, cr.x - 16.0 * ms.x * ms.y, cr.y - 16.0 * ms.x * ms.z,
                         cr.x - 16.0 * ms.x * ms.y, sq.y - 16.0 * ms.y * ms.y, cr.z - 16.0 * ms.y * ms.z,
                         cr.y - 16.0 * ms.x * ms.z, cr.z - 16.0 * ms.y * ms.z, sq.z - 16.0 * ms.z * ms.z);

   vec3 axis = hi - lo;
   const vec3 row = cov * axis;
   axis = dot(row, row) > 1e-6 ? row : axis;
   for (uint it = 0u; it < 3u; it++) {
      const vec3 n = cov * axis;
      const float l = dot(n, n);
      if (l < 1e-12)
         break;
      axis = n * inversesqrt(l);
   }
   axis = dot(axis, axis) > 1e-12 ? normalize(axis) : vec3(0.5);

   float tmin = 1e30, tmax = -1e30;
   [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
      const float t = dot(bc6_lns(i) - mean, axis);
      tmin = min(tmin, t);
      tmax = max(tmax, t);
   }
   vec3 e0 = clamp(mean + axis * tmin, 0.0, 65535.0);
   vec3 e1 = clamp(mean + axis * tmax, 0.0, 65535.0);
   /* Pre-refit: least-squares endpoints for the 12-level weights of the
    * unquantised line, before any (costly) CEM 11 quantisation. */
   {
      const vec3 d = e1 - e0;
      const float dd = dot(d, d);
      float a = 0.0, b = 0.0, c2 = 0.0;
      vec3 x0 = vec3(0.0), x1 = vec3(0.0);
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         const vec3 p = bc6_lns(i);
         const float w = w11_unq(w11_rank(clamp(dd > 0.0 ? dot(p - e0, d) / dd : 0.0, 0.0, 1.0) * 64.0)) / 64.0;
         const float iw = 1.0 - w;
         a += iw * iw; b += iw * w; c2 += w * w;
         x0 += iw * p; x1 += w * p;
      }
      const float det = a * c2 - b * b;
      if (abs(det) > 1e-6) {
         e0 = clamp((c2 * x0 - b * x1) / det, 0.0, 65535.0);
         e1 = clamp((a * x1 - b * x0) / det, 0.0, 65535.0);
      }
   }

   float best = 1e30;
   uvec2 bv = uvec2(0u), bw = uvec2(0u);
   for (uint iter = 0u; iter < 2u; iter++) {
      vec3 q0, q1;
      const uvec2 v = hdr_quant(e0, e1, q0, q1);

      const vec3 d = q1 - q0;
      const float dd = dot(d, d);
      float err = 0.0, a = 0.0, b = 0.0, c2 = 0.0;
      vec3 x0 = vec3(0.0), x1 = vec3(0.0);
      uvec2 wc = uvec2(0u);
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         const vec3 p = bc6_lns(i);
         const uint k = w11_rank(clamp(dd > 0.0 ? dot(p - q0, d) / dd : 0.0, 0.0, 1.0) * 64.0);
         const float u = w11_unq(k);
         wc[i >> 3u] |= k << (4u * (i & 7u));
         const float w = u / 64.0, iw = 1.0 - w;
         const vec3 diff = q0 + d * w - p;
         err += dot(diff, diff);
         a += iw * iw; b += iw * w; c2 += w * w;
         x0 += iw * p; x1 += w * p;
      }
      if (err < best) {
         best = err;
         bv = v;
         bw = wc;
      }
      const float det = a * c2 - b * b;
      if (abs(det) < 1e-6)
         break;
      e0 = clamp((c2 * x0 - b * x1) / det, 0.0, 65535.0);
      e1 = clamp((a * x1 - b * x0) / det, 0.0, 65535.0);
   }

   /* CEM 11, weights 0..11 (R = 3, H = 1), endpoints 8-bit raw. */
   uvec4 blk = astc_header(11u, 3u, 1u, false);
   put_bits(blk, 17u, bv.x & 0xffffu, 16u);
   put_bits(blk, 33u, bv.x >> 16u, 16u);
   put_bits(blk, 49u, bv.y, 16u);
   put_weights(blk, uvec4(ise12_16(bw), 0u, 0u));
   return blk;
}

void main()
{
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    uint bz = gl_GlobalInvocationID.z;

    uint num_blocks_x = uint((registers.width + 3) / 4);
    uint num_blocks_y = uint((registers.height + 3) / 4);

    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
        return;

    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);

    /* Only the output offset stays live across the encoder. */
    const uint out_word = registers.dst_tiled != 0u
        ? (bz * registers.dst_slice_B +
           utile_offset_B(registers.dst_x0 + bx, registers.dst_y0 + by, 2u, 16u)) / 4u
        : (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * 4u;
    bc6_setup(uvec4(ibuf.data[in_word], ibuf.data[in_word + 1u],
                    ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]));

#ifdef DECODE_ONLY
    {
        uint idx = ((bz * num_blocks_y + by) * num_blocks_x + bx) * 64u;
        for (uint p = 0u; p < 16u; p++) {
            uvec3 h = bc6_half(p);
            obuf.data[idx + p * 4u + 0u] = floatBitsToUint(unpackHalf2x16(h.r).x);
            obuf.data[idx + p * 4u + 1u] = floatBitsToUint(unpackHalf2x16(h.g).x);
            obuf.data[idx + p * 4u + 2u] = floatBitsToUint(unpackHalf2x16(h.b).x);
            obuf.data[idx + p * 4u + 3u] = floatBitsToUint(1.0);
        }
        return;
    }
#endif

    uvec4 astc = encode_bc6();

    obuf.data[out_word + 0u] = astc.x;
    obuf.data[out_word + 1u] = astc.y;
    obuf.data[out_word + 2u] = astc.z;
    obuf.data[out_word + 3u] = astc.w;
}
