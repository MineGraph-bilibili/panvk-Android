                        bitfieldExtract(p[0], 15, 10) | (bitfieldExtract(p[1], 21, 1) << 11) | (bitfieldExtract(p[1], 22, 1) << 10),
                        (bitfieldExtract(p[0], 25, 7) | (bitfieldExtract(p[1], 0, 3) << 7)) | (bitfieldExtract(p[1], 31, 1) << 11) | (bitfieldExtract(p[2], 0, 1) << 10)));
