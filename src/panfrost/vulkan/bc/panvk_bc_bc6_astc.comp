                        bitfieldExtract(p[1], 19, 4),
                        bitfieldExtract(p[1], 18, 1) | (bitfieldExtract(p[2], 5, 1) << 1) | (bitfieldExtract(p[2], 6, 1) << 2) | (bitfieldExtract(p[2], 11, 1) << 4) | (bitfieldExtract(p[2], 12, 1) << 3)));
