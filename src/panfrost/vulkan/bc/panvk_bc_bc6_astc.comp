      const uint part = bitfieldExtract(p.z, 13, 5);
      const uint anc = uint(anchor_table2[part]);
      g6_pm = uint(partition_table2[part]) & 0xffffu;
      uint off = 82u;
      for (uint i = 0u; i < 16u; i++) {
         const uint n = (i == 0u || i == anc) ? 2u : 3u;
         uint w = off >> 5u, s = off & 31u;
         uint v = p[w] >> s;
         if (s + n > 32u) v |= p[w + 1u] << (32u - s);
         g6_ix[i >> 3u] |= (v & ((1u << n) - 1u)) << (4u * (i & 7u));
         off += n;
      }
   } else {
      g6_pm = 1u << 16u;
      g6_ix.x = bitfieldExtract(p.z, 1, 3);                 /* texel 0: bits 65..67 */
      uint off = 68u;
      for (uint i = 1u; i < 16u; i++) {
         g6_ix[i >> 3u] |= bitfieldExtract(p[off >> 5u], int(off & 31u), 4) << (4u * (i & 7u));
