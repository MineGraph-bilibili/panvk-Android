                        (bitfieldExtract(p[0], 24, 1) << 4) | bitfieldExtract(p[1], 9, 4),
                        (bitfieldExtract(p[0], 14, 1) << 4) | (bitfieldExtract(p[0], 23, 1) << 5) | (bitfieldExtract(p[1], 29, 3) | (bitfieldExtract(p[2], 0, 1) << 3))));
      e[3] = ivec3(uvec3(bitfieldExtract(p[2], 7, 5),
                        (bitfieldExtract(p[1], 8, 1) << 4) | bitfieldExtract(p[1], 19, 4),
                        (bitfieldExtract(p[0], 13, 1) << 1) | (bitfieldExtract(p[1], 1, 1) << 5) | (bitfieldExtract(p[1], 2, 1) << 4) | bitfieldExtract(p[1], 18, 1) | (bitfieldExtract(p[2], 6, 1) << 2) | (bitfieldExtract(p[2], 12, 1) << 3)));
