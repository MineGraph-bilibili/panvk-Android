const uint M55 = 0x55555555u;

/* ---- bit streams --------------------------------------------------- */

void put_bits(inout uvec4 b, uint off, uint v, uint n)
{
   v &= (1u << n) - 1u;
   uint s = off & 31u;
   uint lo = v << s;
   uint hi = s == 0u ? 0u : v >> (32u - s);
   switch (off >> 5u) {
   case 0u: b.x |= lo; b.y |= hi; break;
   case 1u: b.y |= lo; b.z |= hi; break;
   case 2u: b.z |= lo; b.w |= hi; break;
   default: b.w |= lo; break;
   }
}

/* Packed small values: 8 x 4 bits per word. */
uint pk_get(uvec4 p, uint i)
{
   return (p[i >> 3u] >> ((i & 7u) * 4u)) & 15u;
}

void pk_set(inout uvec4 p, uint i, uint v)
{
   p[i >> 3u] |= v << ((i & 7u) * 4u);
}

/* Header: 4x4 weight grid, one partition. R/H select the weight range. */
uvec4 astc_header(uint cem, uint R, uint H, bool dual)
{
   uint mode = ((R >> 1u) & 3u) | ((R & 1u) << 4u) | (2u << 5u) | (H << 9u) |
               (dual ? (1u << 10u) : 0u);
   return uvec4(mode | (cem << 13u), 0u, 0u, 0u);
}

/* Weights are stored bit-reversed from the top of the block. */
void put_weights(inout uvec4 b, uvec4 w)
{
   b |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z),
              bitfieldReverse(w.y), bitfieldReverse(w.x));
}

/* ---- quantisation ---------------------------------------------------- */

/* Weight unquantisation (0..64) for the bit-only ranges. */
uint wq_bits(uint v, uint nb)
{
   uint r = nb == 2u ? v * 21u :
            nb == 3u ? ((v << 3u) | v) :
            nb == 4u ? ((v << 2u) | (v >> 2u)) :
                       ((v << 1u) | (v >> 4u));
   if (nb == 2u) r = v == 3u ? 63u : r;
   return r > 32u ? r + 1u : r;
}

/* Nearest level in a bit-only weight range for t in [0, 1]. */
uint wnear_bits(float t, uint nb)
{
   const uint mx = (1u << nb) - 1u;
   float x = clamp(t, 0.0, 1.0) * 64.0;
   uint v = uint(clamp(t, 0.0, 1.0) * float(mx) + 0.5);
   uint best = v;
   float be = abs(float(wq_bits(v, nb)) - x);
   if (v > 0u && abs(float(wq_bits(v - 1u, nb)) - x) < be) { best = v - 1u; be = abs(float(wq_bits(v - 1u, nb)) - x); }
   if (v < mx && abs(float(wq_bits(v + 1u, nb)) - x) < be) best = v + 1u;
   return best;
}

/* 0..4 (quint, linear) and 0..5 (trit + bit) weight ranges. */
const uint W5_UNQ[6] = uint[](0u, 12u, 25u, 39u, 52u, 64u);   /* by rank */
const uint W5_ISE[6] = uint[](0u, 2u, 4u, 5u, 3u, 1u);         /* rank -> ISE */

uint wnear_q5(float t) { return uint(clamp(t, 0.0, 1.0) * 4.0 + 0.5); }

uint wnear_t6(float t)
{
   float x = clamp(t, 0.0, 1.0) * 64.0;
   uint best = 0u;
   float be = 1e9;
   for (uint k = 0u; k < 6u; k++) {
      float e = abs(float(W5_UNQ[k]) - x);
      if (e < be) { be = e; best = k; }
   }
   return best;
}

/* ---- BC decoding helpers --------------------------------------------- */

uvec3 dec565(uint c)
{
   uint r = (c >> 11u) & 31u, g = (c >> 5u) & 63u, b = c & 31u;
   return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
}

/* 3-bit index of texel i from a BC3-alpha / BC4 block (index bits start at 16). */
uint idx3(uvec2 w, uint i)
{
   uint pos = 16u + 3u * i;
   if (pos + 3u <= 32u) return (w.x >> pos) & 7u;
   if (pos >= 32u) return (w.y >> (pos - 32u)) & 7u;
   return ((w.x >> pos) | (w.y << (32u - pos))) & 7u;
}

/* BC3-alpha / BC4 palette entry k (8-bit). */
uint pal8(uvec2 w, uint k)
{
   uint a0 = w.x & 0xffu, a1 = (w.x >> 8u) & 0xffu;
   if (k == 0u) return a0;
   if (k == 1u) return a1;
   if (a0 > a1) return (a0 * (8u - k) + a1 * (k - 1u) + 3u) / 7u;
   if (k == 6u) return 0u;
   if (k == 7u) return 255u;
   return (a0 * (6u - k) + a1 * (k - 1u) + 2u) / 5u;
}

uint e127(uint v) { return (v * 127u + 127u) / 255u; }
uint e127_unq(uint q) { return (q << 1u) | (q >> 6u); }


/* HDR ASTC (CEM 11, HDR RGB direct) for BC6H. Endpoints live in the 16-bit
 * pseudo-logarithmic (LNS) space the decoder interpolates in; the packing
 * below mirrors the decoder in ASTC spec C.2.14 (validated against the
 * Mali-G615 hardware decoder). Weights: 0..11, endpoints: 8-bit raw. */

/* Per-mode bit counts (ASTC spec C.2.14), 4 bits each. */
uint hdr_abits(uint m) { return (0xccbbaa99u >> (4u * m)) & 15u; }
uint hdr_bbits(uint m) { return (0x67687687u >> (4u * m)) & 15u; }
uint hdr_cbits(uint m) { return (0x77867766u >> (4u * m)) & 15u; }
uint hdr_dbits(uint m) { return (0x65656767u >> (4u * m)) & 15u; }

int hdr_q(int x, uint s)
{
   int h = int((1u << s) >> 1u);
   return x >= 0 ? (x + h) >> s : -((-x + h) >> s);
}

void hdr_pack(ivec3 lo, ivec3 hi, uint mode, uint maj, out uint v[6])
{
   if (maj == 1u) { lo = lo.grb; hi = hi.grb; }
   if (maj == 2u) { lo = lo.bgr; hi = hi.bgr; }
   uint s = (mode >> 1u) ^ 3u;
   int a = clamp(hdr_q(hi.r, s), 0, (1 << hdr_abits(mode)) - 1);
   int A = a << s;
   int bm = (1 << hdr_bbits(mode)) - 1;
   int b0 = clamp(hdr_q(A - hi.g, s), 0, bm);
   int b1 = clamp(hdr_q(A - hi.b, s), 0, bm);
   int c = clamp(hdr_q(A - lo.r, s), 0, (1 << hdr_cbits(mode)) - 1);
   int db = int(hdr_dbits(mode));
   int dl = -(1 << (db - 1)), dh = (1 << (db - 1)) - 1;
   int d0 = clamp(hdr_q(A - (b0 << s) - (c << s) - lo.g, s), dl, dh) & ((1 << db) - 1);
   int d1 = clamp(hdr_q(A - (b1 << s) - (c << s) - lo.b, s), dl, dh) & ((1 << db) - 1);
   uint oh = 1u << mode;
   uint x0 = 0u, x1 = 0u, x2 = 0u, x3 = 0u, x4 = 0u, x5 = 0u;
   uint ua = uint(a), uc = uint(c), ub0 = uint(b0), ub1 = uint(b1), ud0 = uint(d0), ud1 = uint(d1);
   if ((oh & 0xA4u) != 0u) x0 = (ua >> 9u) & 1u;
   if ((oh & 0x08u) != 0u) x2 = (ua >> 9u) & 1u;
   if ((oh & 0x50u) != 0u) { x4 = (ua >> 9u) & 1u; x5 = (ua >> 10u) & 1u; }
   if ((oh & 0xA0u) != 0u) x1 = (ua >> 10u) & 1u;
   if ((oh & 0xC0u) != 0u) x2 = (ua >> 11u) & 1u;
   if ((oh & 0x04u) != 0u) x1 = (uc >> 6u) & 1u;
   if ((oh & 0xE8u) != 0u) x3 = (uc >> 6u) & 1u;
   if ((oh & 0x20u) != 0u) x2 = (uc >> 7u) & 1u;
   if ((oh & 0x5Bu) != 0u) { x0 = (ub0 >> 6u) & 1u; x1 = (ub1 >> 6u) & 1u; }
   if ((oh & 0x12u) != 0u) { x2 = (ub0 >> 7u) & 1u; x3 = (ub1 >> 7u) & 1u; }
   if ((oh & 0xAFu) != 0u) { x4 = (ud0 >> 5u) & 1u; x5 = (ud1 >> 5u) & 1u; }
   if ((oh & 0x05u) != 0u) { x2 = (ud0 >> 6u) & 1u; x3 = (ud1 >> 6u) & 1u; }
   v[0] = ua & 0xffu;
   v[1] = (uc & 0x3fu) | (((ua >> 8u) & 1u) << 6u) | ((mode & 1u) << 7u);
   v[2] = (ub0 & 0x3fu) | (x0 << 6u) | (((mode >> 1u) & 1u) << 7u);
   v[3] = (ub1 & 0x3fu) | (x1 << 6u) | (((mode >> 2u) & 1u) << 7u);
   v[4] = (ud0 & 0x1fu) | (x4 << 5u) | (x2 << 6u) | ((maj & 1u) << 7u);
   v[5] = (ud1 & 0x1fu) | (x5 << 5u) | (x3 << 6u) | (((maj >> 1u) & 1u) << 7u);
}


/* ---- BC6H: block-oriented decode ------------------------------------ */

#define VK_FORMAT_BC6H_UFLOAT_BLOCK 143
#define VK_FORMAT_BC6H_SFLOAT_BLOCK 144
const bool BC6_SIGNED = SPEC_FORMAT == VK_FORMAT_BC6H_SFLOAT_BLOCK;

/* Decoded once per block: per subset, the unquantised endpoints as 16-bit
 * pairs (e0 low, e1 high) per channel; the 16 indices (4 bits each) and the
 * subset mask in bits 0..15 of g6_pm, with bit 16 set for 4-bit indices. */
uvec3 g6_s0, g6_s1;
uvec2 g6_ix;
uint g6_pm;

ivec3 bc6_unq(ivec3 v, int eb)
{
   if (BC6_SIGNED) {
      v = bitfieldExtract(v, 0, eb);
      if (eb >= 16)
         return v;
      ivec3 a = abs(v);
      ivec3 u = ((a << 15) + 0x4000) >> (eb - 1);
      u = mix(u, ivec3(0x7fff), greaterThanEqual(a, ivec3((1 << (eb - 1)) - 1)));
      u = mix(u, ivec3(0), equal(v, ivec3(0)));
      return mix(u, -u, lessThan(v, ivec3(0)));
   }
   if (eb >= 15)
      return v;
   ivec3 u = ((v << 15) + 0x4000) >> (eb - 1);
   u = mix(u, ivec3(0xffff), equal(v, ivec3((1 << eb) - 1)));
   return mix(u, ivec3(0), equal(v, ivec3(0)));
}

void bc6_setup(uvec4 p)
