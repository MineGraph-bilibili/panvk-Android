                        bitfieldExtract(p[1], 13, 4),
                        bitfieldExtract(p[1], 23, 5)));
      e[2] = ivec3(uvec3(bitfieldExtract(p[2], 1, 4),
                        bitfieldExtract(p[1], 9, 4),
                        (bitfieldExtract(p[1], 8, 1) << 4) | (bitfieldExtract(p[1], 29, 3) | (bitfieldExtract(p[2], 0, 1) << 3))));
