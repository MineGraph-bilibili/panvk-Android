   } else [[dont_flatten]] if (num == 10u) { /* 10010 */
      e[0] = ivec3(uvec3(bitfieldExtract(p[0], 5, 8),
                        bitfieldExtract(p[0], 15, 8),
                        (bitfieldExtract(p[0], 25, 7) | (bitfieldExtract(p[1], 0, 1) << 7))));
      e[1] = ivec3(uvec3(bitfieldExtract(p[1], 3, 6),
                        bitfieldExtract(p[1], 13, 5),
                        bitfieldExtract(p[1], 23, 5)));
      e[2] = ivec3(uvec3(bitfieldExtract(p[2], 1, 6),
                        (bitfieldExtract(p[0], 24, 1) << 4) | bitfieldExtract(p[1], 9, 4),
                        (bitfieldExtract(p[0], 14, 1) << 4) | (bitfieldExtract(p[1], 29, 3) | (bitfieldExtract(p[2], 0, 1) << 3))));
