      e[0] = ivec3(uvec3(bitfieldExtract(p[0], 5, 10),
                        bitfieldExtract(p[0], 15, 10),
                        (bitfieldExtract(p[0], 25, 7) | (bitfieldExtract(p[1], 0, 3) << 7))));
