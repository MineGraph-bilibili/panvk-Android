                        (bitfieldExtract(p[0], 11, 1) << 4) | (bitfieldExtract(p[0], 31, 1) << 5) | bitfieldExtract(p[1], 19, 4),
                        bitfieldExtract(p[0], 12, 1) | (bitfieldExtract(p[0], 13, 1) << 1) | (bitfieldExtract(p[0], 23, 1) << 2) | (bitfieldExtract(p[1], 0, 1) << 3) | (bitfieldExtract(p[1], 1, 1) << 5) | (bitfieldExtract(p[1], 2, 1) << 4)));
