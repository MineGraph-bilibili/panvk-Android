/* BC1-BC3, BC4/BC5 UNORM -> ASTC 4x4, one thread per block.
 *
 * BCn blocks are already "endpoints + per-texel index" encodings, so most
 * of them map onto an ASTC block directly: the BC endpoints become ASTC
 * endpoints and each BC index becomes an ASTC weight. Only the block's
 * palette (<= 4 colours, <= 8 values per channel) and its index bits are
 * kept live - never 16 decoded texels.
 *
 *  BC1 4-colour, BC2/BC3 constant alpha   CEM 8/12, weights 0..3, 8-bit endpoints (exact)
 *  BC1 3-colour without index 3           CEM 8,    weights 0..2, 8-bit endpoints (exact)
 *  BC1 RGBA punch-through                 CEM 12 dual plane (alpha), weights 0..2, 7-bit endpoints
 *  BC1 RGB 3-colour with opaque black     CEM 8, principal-axis fit of the 4 palette colours
 *  BC2/BC3 varying alpha                  CEM 12 dual plane (alpha), weights 0..3, endpoints 0..47
 *  BC4 UNORM                              CEM 0, weights 0..31, 8-bit endpoints
 *  BC5 UNORM                              CEM 4 dual plane, best of (0..4, 8-bit) / (0..5, 6-bit)
 */

layout(constant_id = 0) const int SPEC_FORMAT = 0;
#define VK_FORMAT_BC1_RGB_UNORM_BLOCK 131
#define VK_FORMAT_BC1_RGB_SRGB_BLOCK 132
#define VK_FORMAT_BC1_RGBA_UNORM_BLOCK 133
#define VK_FORMAT_BC1_RGBA_SRGB_BLOCK 134
#define VK_FORMAT_BC2_UNORM_BLOCK 135
#define VK_FORMAT_BC2_SRGB_BLOCK 136
#define VK_FORMAT_BC3_UNORM_BLOCK 137
#define VK_FORMAT_BC3_SRGB_BLOCK 138
#define VK_FORMAT_BC4_UNORM_BLOCK 139
#define VK_FORMAT_BC5_UNORM_BLOCK 141


const uint M55 = 0x55555555u;

/* ---- bit streams --------------------------------------------------- */

void put_bits(inout uvec4 b, uint off, uint v, uint n)
{
   v &= (1u << n) - 1u;
   uint s = off & 31u;
   uint lo = v << s;
   uint hi = s == 0u ? 0u : v >> (32u - s);
   switch (off >> 5u) {
   case 0u: b.x |= lo; b.y |= hi; break;
   case 1u: b.y |= lo; b.z |= hi; break;
   case 2u: b.z |= lo; b.w |= hi; break;
   default: b.w |= lo; break;
   }
}

/* Packed small values: 8 x 4 bits per word. */
uint pk_get(uvec4 p, uint i)
{
   return (p[i >> 3u] >> ((i & 7u) * 4u)) & 15u;
}

void pk_set(inout uvec4 p, uint i, uint v)
{
   p[i >> 3u] |= v << ((i & 7u) * 4u);
}

/* Integer sequence encoding of `count` packed values; kind 1 trits, 2 quints. */
uint ise_write(inout uvec4 b, uint off, uvec4 vals, uint count, uint nb, uint kind)
{
   const uint gs = kind == 1u ? 5u : 3u;
   const uint mask = (1u << nb) - 1u;
   for (uint g = 0u; g < count; g += gs) {
      uint t0 = 0u, t1 = 0u, t2 = 0u, t3 = 0u, t4 = 0u;
      uint n = min(gs, count - g);
      for (uint j = 0u; j < n; j++) {
         uint t = pk_get(vals, g + j) >> nb;
         if (j == 0u) t0 = t; else if (j == 1u) t1 = t; else if (j == 2u) t2 = t;
         else if (j == 3u) t3 = t; else t4 = t;
      }
      uint packed = kind == 1u ? TRIT_PACK[t0 + 3u * t1 + 9u * t2 + 27u * t3 + 81u * t4]
                               : QUINT_PACK[t0 + 5u * t1 + 25u * t2];
      uint shift = 0u;
      for (uint j = 0u; j < n; j++) {
         put_bits(b, off, pk_get(vals, g + j) & mask, nb);
         off += nb;
         uint tb = kind == 1u ? ((j == 2u || j == 4u) ? 1u : 2u) : (j == 0u ? 3u : 2u);
         put_bits(b, off, packed >> shift, tb);
         off += tb;
         shift += tb;
      }
   }
   return off;
}

/* Header: 4x4 weight grid, one partition. R/H select the weight range. */
uvec4 astc_header(uint cem, uint R, uint H, bool dual)
{
   uint mode = ((R >> 1u) & 3u) | ((R & 1u) << 4u) | (2u << 5u) | (H << 9u) |
               (dual ? (1u << 10u) : 0u);
   return uvec4(mode | (cem << 13u), 0u, 0u, 0u);
}

/* Weights are stored bit-reversed from the top of the block. */
void put_weights(inout uvec4 b, uvec4 w)
{
   b |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z),
              bitfieldReverse(w.y), bitfieldReverse(w.x));
}

/* ---- quantisation ---------------------------------------------------- */

/* Weight unquantisation (0..64) for the bit-only ranges. */
uint wq_bits(uint v, uint nb)
{
   uint r = nb == 2u ? v * 21u :
            nb == 3u ? ((v << 3u) | v) :
            nb == 4u ? ((v << 2u) | (v >> 2u)) :
                       ((v << 1u) | (v >> 4u));
   if (nb == 2u) r = v == 3u ? 63u : r;
   return r > 32u ? r + 1u : r;
}

/* Nearest level in a bit-only weight range for t in [0, 1]. */
uint wnear_bits(float t, uint nb)
{
   const uint mx = (1u << nb) - 1u;
   float x = clamp(t, 0.0, 1.0) * 64.0;
   uint v = uint(clamp(t, 0.0, 1.0) * float(mx) + 0.5);
   uint best = v;
   float be = abs(float(wq_bits(v, nb)) - x);
   if (v > 0u && abs(float(wq_bits(v - 1u, nb)) - x) < be) { best = v - 1u; be = abs(float(wq_bits(v - 1u, nb)) - x); }
   if (v < mx && abs(float(wq_bits(v + 1u, nb)) - x) < be) best = v + 1u;
   return best;
}

/* 0..4 (quint, linear) and 0..5 (trit + bit) weight ranges. */

uint wnear_q5(float t) { return uint(clamp(t, 0.0, 1.0) * 4.0 + 0.5); }

/* rank -> unquantised weight (0, 12, 25, 39, 52, 64) and ISE value, as
 * packed constants rather than indexed tables */
uint w5_unq(uint r) { return (r < 4u ? (0x27190c00u >> (8u * r)) : (0x4034u >> (8u * (r - 4u)))) & 0xffu; }
uint w5_ise(uint r) { return (0xbb10u >> (3u * r)) & 7u; }

uint wnear_t6(float t)
{
   const float x = clamp(t, 0.0, 1.0) * 64.0;
   const uint r = uint(clamp(t, 0.0, 1.0) * 5.0 + 0.5);
   uint best = r;
   float be = abs(float(w5_unq(r)) - x);
   if (r > 0u) { const float e = abs(float(w5_unq(r - 1u)) - x); if (e <= be) { best = r - 1u; be = e; } }
   if (r < 5u) { const float e = abs(float(w5_unq(r + 1u)) - x); if (e < be) best = r + 1u; }
   return best;
}

/* ---- BC decoding helpers --------------------------------------------- */

uvec3 dec565(uint c)
{
   uint r = (c >> 11u) & 31u, g = (c >> 5u) & 63u, b = c & 31u;
   return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
}

/* 3-bit index of texel i from a BC3-alpha / BC4 block (index bits start at 16). */
uint idx3(uvec2 w, uint i)
{
   uint pos = 16u + 3u * i;
   if (pos + 3u <= 32u) return (w.x >> pos) & 7u;
   if (pos >= 32u) return (w.y >> (pos - 32u)) & 7u;
   return ((w.x >> pos) | (w.y << (32u - pos))) & 7u;
}

/* BC3-alpha / BC4 palette entry k (8-bit). */
uint pal8(uvec2 w, uint k)
{
   uint a0 = w.x & 0xffu, a1 = (w.x >> 8u) & 0xffu;
   if (k == 0u) return a0;
   if (k == 1u) return a1;
   if (a0 > a1) return ((a0 * (8u - k) + a1 * (k - 1u) + 3u) * 9363u) >> 16u;
   if (k == 6u) return 0u;
   if (k == 7u) return 255u;
   return ((a0 * (6u - k) + a1 * (k - 1u) + 2u) * 13108u) >> 16u;
}

uint e127(uint v) { return (v * 127u + 127u) / 255u; }
uint e127_unq(uint q) { return (q << 1u) | (q >> 6u); }

/* ---- texel access ----------------------------------------------------- */

/* Decoded texel i (0..255 per channel) straight from the block words; the
 * encoder re-decodes on every pass instead of keeping 16 texels live. */
vec4 bc_texel(uvec4 w, int format, uint i)
{
   if (format == VK_FORMAT_BC4_UNORM_BLOCK)
      return vec4(float(pal8(w.xy, idx3(w.xy, i))), 0.0, 0.0, 255.0);
   if (format == VK_FORMAT_BC5_UNORM_BLOCK)
      return vec4(float(pal8(w.xy, idx3(w.xy, i))), float(pal8(w.zw, idx3(w.zw, i))), 0.0, 255.0);

   const bool bc1 = format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK;
   const uvec2 cw = bc1 ? w.xy : w.zw;
   const uint c0 = cw.x & 0xffffu, c1 = cw.x >> 16u;
   const vec3 e0 = vec3(dec565(c0)), e1 = vec3(dec565(c1));
   const bool four = !bc1 || c0 > c1;
   const uint k = (cw.y >> (2u * i)) & 3u;
   vec3 c = k == 0u ? e0 : k == 1u ? e1 :
            four ? (k == 2u ? (2.0 * e0 + e1) / 3.0 : (e0 + 2.0 * e1) / 3.0) :
                   (k == 2u ? (e0 + e1) * 0.5 : vec3(0.0));
   float a = 255.0;
   if (bc1)
      a = (!four && k == 3u && format >= VK_FORMAT_BC1_RGBA_UNORM_BLOCK) ? 0.0 : 255.0;
   else if (format <= VK_FORMAT_BC2_SRGB_BLOCK)
      a = float(((w[i >> 3u] >> ((i & 7u) * 4u)) & 15u) * 17u);
   else
      a = float(pal8(w.xy, idx3(w.xy, i)));
   return vec4(c, a);
}

/* ---- generic quantisers ---------------------------------------------- */

#define WR3  0u /* 0..3  bits  */
#define WR4  1u /* 0..4  quint */
#define WR5  2u /* 0..5  trit  */
#define WR15 3u /* 0..15 bits  */
#define WR31 4u /* 0..31 bits  */
#define ER47  0u
#define ER191 1u
#define ER63  2u
#define ER255 3u

/* Weight level for t in [0,1]: returns ISE value, unq (0..64) out. */
uint wlevel(uint wr, float t, out float unq)
{
   uint v;
   if (wr == WR4) {
      v = wnear_q5(t);
      unq = float(v * 16u);
      return v;
   }
   if (wr == WR5) {
      uint r = wnear_t6(t);
      unq = float(w5_unq(r));
      return w5_ise(r);
   }
   uint nb = wr == WR3 ? 2u : wr == WR15 ? 4u : 5u;
   v = wnear_bits(t, nb);
   unq = float(wq_bits(v, nb));
   return v;
}

/* Endpoint quantisation of v (0..255): returns ISE code, unq out. */
uint eq(uint er, float v, out float unq)
{
   uint x = uint(clamp(v, 0.0, 255.0) + 0.5);
   if (er == ER255) { unq = float(x); return x; }
   if (er == ER63) {
      uint q = (x * 63u + 127u) / 255u;
      unq = float((q << 2u) | (q >> 4u));
      return q;
   }
   uint l = er == ER47 ? E47_LUT[x] : E191_LUT[x];
   unq = float(l >> 8u);
   return l & 0xffu;
}

/* Write up to 8 endpoint codes (8 bits each, packed in uvec2). */
void put_endpoints(inout uvec4 b, uvec2 codes, uint count, uint er)
{
   uint off = 17u;
   if (er == ER255 || er == ER63) {
      uint nb = er == ER255 ? 8u : 6u;
      for (uint k = 0u; k < count; k++) {
         put_bits(b, off, (codes[k >> 2u] >> (8u * (k & 3u))) & 0xffu, nb);
         off += nb;
      }
      return;
   }
   const uint nb = er == ER47 ? 4u : 6u;
   for (uint g = 0u; g < count; g += 5u) {
      uint n = min(5u, count - g);
      uint t[5] = uint[](0u, 0u, 0u, 0u, 0u);
      for (uint j = 0u; j < n; j++)
         t[j] = ((codes[(g + j) >> 2u] >> (8u * ((g + j) & 3u))) & 0xffu) >> nb;
      uint packed = TRIT_PACK[t[0] + 3u * t[1] + 9u * t[2] + 27u * t[3] + 81u * t[4]];
      uint shift = 0u;
      for (uint j = 0u; j < n; j++) {
         uint c = (codes[(g + j) >> 2u] >> (8u * ((g + j) & 3u))) & 0xffu;
         put_bits(b, off, c, nb);
         off += nb;
         uint tb = (j == 2u || j == 4u) ? 1u : 2u;
         put_bits(b, off, packed >> shift, tb);
         off += tb;
         shift += tb;
      }
   }
}

/* ---- streaming line encoder ------------------------------------------ */

/* Map a texel into endpoint-channel space: LA modes carry (x, y) in L, A. */
vec4 chan(vec4 t, uint cem)
{
   return cem == 4u ? vec4(t.r, t.g, 0.0, 0.0) : cem == 0u ? vec4(t.r, 0.0, 0.0, 0.0) : t;
}

/* What the decoder returns for channel space value d (channels >= nch). */
vec4 fill(vec4 d, uint cem)
{
   if (cem == 8u) d.a = 255.0;
   return d;
}

/* Principal-axis fit + least-squares refit, single or dual plane (second
 * plane = channel p1). Returns squared error; the block in blk. */
float enc_line(uvec4 src, int format, uint cem, bool dual, uint wr, uint er, float skip_if, out uvec4 blk)
{
   const uint nch = cem == 0u ? 1u : cem == 4u ? 2u : cem == 8u ? 3u : 4u;
   const uint p1 = cem == 4u ? 1u : 3u;
   const vec4 cm = vec4(1.0, nch > 1u ? 1.0 : 0.0, nch > 2u ? 1.0 : 0.0, nch > 3u ? 1.0 : 0.0);
   vec4 m1 = vec4(0.0);
   if (dual) m1[p1] = 1.0;
   const vec4 m0 = cm - m1;

   /* One pass: sums for the mean and the covariance (E[pp^T] - mean mean^T),
    * texels scaled to 0..1 to keep the sums small. */
   vec4 mean = vec4(0.0);
   mat4 cov = mat4(0.0);
   float amin = 1e9, amax = -1e9;
   vec4 lo = vec4(1e9), hi = vec4(-1e9);
   for (uint i = 0u; i < 16u; i++) {
      vec4 p = chan(bc_texel(src, format, i), cem);
      vec4 s = p * (1.0 / 255.0) * m0;
      mean += p;
      cov += outerProduct(s, s);
      float a = dot(p, m1);
      amin = min(amin, a);
      amax = max(amax, a);
      lo = min(lo, p);
      hi = max(hi, p);
   }
   mean *= 1.0 / 16.0;
   {
      vec4 ms = mean * (1.0 / 255.0) * m0;
      cov = cov - outerProduct(ms, ms) * 16.0;
   }
   vec4 axis = (hi - lo) * m0;
   vec4 row = cov * axis;
   axis = dot(row, row) > 1e-6 ? row : axis;
   [[dont_unroll]] for (uint it = 0u; it < 8u; it++) {
      vec4 nx = cov * axis;
      float l = dot(nx, nx);
      if (l < 1e-12) break;
      axis = nx * inversesqrt(l);
   }
   axis = dot(axis, axis) > 1e-12 ? normalize(axis) : m0 * 0.5;
   {
      /* Every single-line encoding errs by at least the energy off the best
       * line: stop when that already loses to the caller's candidate. */
      const float lam = dot(axis, cov * axis) / max(dot(axis, axis), 1e-12);
      const float off = (cov[0][0] + cov[1][1] + cov[2][2] + cov[3][3] - lam) * 65025.0;
      if (off >= skip_if) { blk = uvec4(0u); return 1e30; }
   }

   float tmin = 1e9, tmax = -1e9;
   for (uint i = 0u; i < 16u; i++) {
      float t = dot((chan(bc_texel(src, format, i), cem) - mean) * m0, axis);
      tmin = min(tmin, t);
      tmax = max(tmax, t);
   }
   vec4 e0 = (mean + axis * tmin) * m0 + m1 * amin;
   vec4 e1 = (mean + axis * tmax) * m0 + m1 * amax;

   float best = 1e30;
   vec4 bq0 = vec4(0.0), bq1 = vec4(0.0);
   uvec2 bc = uvec2(0u);

   [[dont_unroll]] for (uint iter = 0u; iter < 3u; iter++) {
      vec4 q0 = vec4(0.0), q1 = vec4(0.0);
      uint c0 = 0u, c1 = 0u;  /* codes, 8 bits per channel */
      for (uint c = 0u; c < nch; c++) {
         float u;
         c0 |= eq(er, e0[c], u) << (8u * c); q0[c] = u;
         c1 |= eq(er, e1[c], u) << (8u * c); q1[c] = u;
      }
      if (cem >= 8u && q1.r + q1.g + q1.b < q0.r + q0.g + q0.b) {
         vec4 tq = q0; q0 = q1; q1 = tq;
         uint tc = c0; c0 = c1; c1 = tc;
      }
      const vec4 d0 = (q1 - q0) * m0;
      const float dd = dot(d0, d0);
      const float d1 = dot(q1 - q0, m1);

      float err = 0.0;
      float a = 0.0, b = 0.0, cc = 0.0, aa = 0.0, ab = 0.0, ac = 0.0;
      vec4 x0 = vec4(0.0), x1 = vec4(0.0);
      float ax0 = 0.0, ax1 = 0.0;
      for (uint i = 0u; i < 16u; i++) {
         vec4 t4 = bc_texel(src, format, i);
         vec4 p = chan(t4, cem);
         float u0, u1 = 0.0;
         wlevel(wr, dd > 0.0 ? dot((p - q0) * m0, d0) / dd : 0.0, u0);
         float w0 = u0 / 64.0, w1 = 0.0;
         vec4 dec = q0 + (q1 - q0) * w0;
         if (dual) {
            wlevel(wr, d1 != 0.0 ? (dot(p, m1) - dot(q0, m1)) / d1 : 0.0, u1);
            w1 = u1 / 64.0;
            dec = dec * (vec4(1.0) - m1) + (q0 + (q1 - q0) * w1) * m1;
         }
         vec4 full = fill(dec * cm, cem);
         vec4 ref = cem == 8u ? t4 : p;
         vec4 diff = full - (cem == 8u ? ref : ref * cm);
         err += dot(diff, diff);
         float iw = 1.0 - w0;
         a += iw * iw; b += iw * w0; cc += w0 * w0;
         x0 += iw * p; x1 += w0 * p;
         if (dual) {
            float iw1 = 1.0 - w1;
            aa += iw1 * iw1; ab += iw1 * w1; ac += w1 * w1;
            ax0 += iw1 * dot(p, m1); ax1 += w1 * dot(p, m1);
         }
      }
      if (err < best) {
         best = err;
         bq0 = q0; bq1 = q1;
         bc = uvec2(0u);
         /* interleave codes: c0[ch], c1[ch] for each channel */
         for (uint c = 0u; c < nch; c++) {
            uint k0 = 2u * c, k1 = 2u * c + 1u;
            bc[k0 >> 2u] |= ((c0 >> (8u * c)) & 0xffu) << (8u * (k0 & 3u));
            bc[k1 >> 2u] |= ((c1 >> (8u * c)) & 0xffu) << (8u * (k1 & 3u));
         }
      }
      float det = a * cc - b * b;
      if (abs(det) > 1e-6) {
         e0 = clamp((cc * x0 - b * x1) / det, 0.0, 255.0) * m0;
         e1 = clamp((a * x1 - b * x0) / det, 0.0, 255.0) * m0;
      } else {
         e0 = q0 * m0; e1 = q1 * m0;
      }
      if (dual) {
         float deta = aa * ac - ab * ab;
         float a0 = abs(deta) > 1e-6 ? clamp((ac * ax0 - ab * ax1) / deta, 0.0, 255.0) : dot(q0, m1);
         float a1 = abs(deta) > 1e-6 ? clamp((aa * ax1 - ab * ax0) / deta, 0.0, 255.0) : dot(q1, m1);
         e0 += m1 * a0; e1 += m1 * a1;
      }
   }

   /* Assemble the best candidate. */
   const uint R = wr == WR3 ? 4u : wr == WR4 ? 5u : wr == WR5 ? 6u : wr == WR15 ? 4u : 7u;
   const uint Hb = (wr == WR15 || wr == WR31) ? 1u : 0u;
   blk = astc_header(cem, R, Hb, dual);
   put_endpoints(blk, bc, 2u * nch, er);
   const vec4 d0 = (bq1 - bq0) * m0;
   const float dd = dot(d0, d0);
   const float d1 = dot(bq1 - bq0, m1);
   uvec4 vals = uvec4(0u), w = uvec4(0u);
   uint wbits;
   if (wr == WR31) {
      for (uint i = 0u; i < 16u; i++) {
         vec4 p = chan(bc_texel(src, format, i), cem);
         float u;
         put_bits(w, 5u * i, wlevel(wr, dd > 0.0 ? dot((p - bq0) * m0, d0) / dd : 0.0, u), 5u);
      }
      wbits = 80u;
   } else {
      const uint n = dual ? 32u : 16u;
      for (uint i = 0u; i < 16u; i++) {
         vec4 p = chan(bc_texel(src, format, i), cem);
         float u;
         uint v0 = wlevel(wr, dd > 0.0 ? dot((p - bq0) * m0, d0) / dd : 0.0, u);
         if (dual) {
            uint v1 = wlevel(wr, d1 != 0.0 ? (dot(p, m1) - dot(bq0, m1)) / d1 : 0.0, u);
            pk_set(vals, 2u * i, v0);
            pk_set(vals, 2u * i + 1u, v1);
         } else {
            pk_set(vals, i, v0);
         }
      }
      if (wr == WR3 || wr == WR15) {
         uint nb = wr == WR3 ? 2u : 4u;
         for (uint k = 0u; k < n; k++)
            put_bits(w, nb * k, pk_get(vals, k), nb);
         wbits = nb * n;
      } else {
         wbits = ise_write(w, 0u, vals, n, wr == WR5 ? 1u : 0u, wr == WR5 ? 1u : 2u);
      }
   }
   put_weights(blk, w);
   if (dual)
      put_bits(blk, 128u - wbits - 2u, 3u, 2u);
   return best;
}


/* ---- direct alpha paths ------------------------------------------------ */


uint alpha_of(uvec4 src, bool bc2, uint i)
{
   return bc2 ? ((src[i >> 3u] >> ((i & 7u) * 4u)) & 15u) * 17u : pal8(src.xy, idx3(src.xy, i));
}

/* Spread 16 2-bit values to the even (colour) slots of 32 2-bit slots. */
uvec2 spread2(uint v)
{
   uvec2 r = uvec2(v & 0xffffu, v >> 16u);
   r = (r | (r << 8u)) & 0x00ff00ffu;
   r = (r | (r << 4u)) & 0x0f0f0f0fu;
   r = (r | (r << 2u)) & 0x33333333u;
   return r;
}

/* BC2/BC3, varying alpha: dual plane CEM 12, 2-bit weights, 0..47 endpoints.
 * Colour keeps the BC1 line, alpha gets a 1-D fit. Returns squared error. */
float enc_alpha_dual(uvec4 src, bool bc2, out uvec4 blk)
{
   uvec4 ac = uvec4(0u);
   for (uint i = 0u; i < 16u; i++)
      ac[i >> 2u] |= alpha_of(src, bc2, i) << (8u * (i & 3u));
   const uint idx = src.w;
   const vec3 e0 = vec3(dec565(src.z & 0xffffu)), e1 = vec3(dec565(src.z >> 16u));
   const vec3 de = e1 - e0;

   /* colour plane: start on the BC1 line, then least-squares refits as in
    * enc_line, keeping the best quantised pair */
   vec3 f0 = e0, f1 = e1;
   float err = 1e30;
   uint k0 = 0u, k1 = 0u, cw = 0u;
   [[dont_unroll]] for (uint it = 0u; it < 2u; it++) {
      vec3 q0, q1;
      uint c0 = 0u, c1 = 0u;
      for (uint c = 0u; c < 3u; c++) {
         float u;
         c0 |= eq(ER47, f0[c], u) << (8u * c); q0[c] = u;
         c1 |= eq(ER47, f1[c], u) << (8u * c); q1[c] = u;
      }
      if (q1.r + q1.g + q1.b < q0.r + q0.g + q0.b) {
         vec3 t = q0; q0 = q1; q1 = t;
         uint tk = c0; c0 = c1; c1 = tk;
      }
      const vec3 d = q1 - q0;
      const float dd = dot(d, d);
      float e = 0.0, s00 = 0.0, s01 = 0.0, s11 = 0.0;
      vec3 x0 = vec3(0.0), x1 = vec3(0.0);
      uint w2 = 0u;
      for (uint i = 0u; i < 16u; i++) {
         const uint k = (idx >> (2u * i)) & 3u;
         const float f = k == 0u ? 0.0 : k == 1u ? 1.0 : k == 2u ? (1.0 / 3.0) : (2.0 / 3.0);
         const vec3 p = e0 + de * f;
         const uint v = wnear_bits(dd > 0.0 ? dot(p - q0, d) / dd : 0.0, 2u);
         w2 |= v << (2u * i);
         const float w = float(wq_bits(v, 2u)) / 64.0, iw = 1.0 - w;
         const vec3 r = q0 + d * w - p;
         e += dot(r, r);
         s00 += iw * iw; s01 += iw * w; s11 += w * w;
         x0 += iw * p; x1 += w * p;
      }
      if (e < err) { err = e; k0 = c0; k1 = c1; cw = w2; }
      const float det = s00 * s11 - s01 * s01;
      if (abs(det) <= 1e-6 || e == 0.0) break;
      f0 = clamp((s11 * x0 - s01 * x1) / det, 0.0, 255.0);
      f1 = clamp((s00 * x1 - s01 * x0) / det, 0.0, 255.0);
   }

   float amin = 255.0, amax = 0.0;
   for (uint i = 0u; i < 16u; i++) {
      const float a = float((ac[i >> 2u] >> (8u * (i & 3u))) & 0xffu);
      amin = min(amin, a);
      amax = max(amax, a);
   }

   float A0 = amin, A1 = amax, aerr = 1e30;
   uint ka = 0u, aw = 0u;
   for (uint it = 0u; it < 3u; it++) {
      float u0, u1;
      const uint c0 = eq(ER47, A0, u0), c1 = eq(ER47, A1, u1);
      const float da = u1 - u0;
      float e = 0.0, s00 = 0.0, s01 = 0.0, s11 = 0.0, x0 = 0.0, x1 = 0.0;
      uint w2 = 0u;
      for (uint i = 0u; i < 16u; i++) {
         const float a = float((ac[i >> 2u] >> (8u * (i & 3u))) & 0xffu);
         const uint v = wnear_bits(da != 0.0 ? (a - u0) / da : 0.0, 2u);
         w2 |= v << (2u * i);
         const float w = float(wq_bits(v, 2u)) / 64.0, iw = 1.0 - w;
         const float r = u0 + da * w - a;
         e += r * r;
         s00 += iw * iw; s01 += iw * w; s11 += w * w;
         x0 += iw * a; x1 += w * a;
      }
      if (e < aerr) { aerr = e; ka = c0 | (c1 << 8u); aw = w2; }
      const float det = s00 * s11 - s01 * s01;
      if (abs(det) < 1e-6 || e == 0.0) break;
      A0 = clamp((s11 * x0 - s01 * x1) / det, 0.0, 255.0);
      A1 = clamp((s00 * x1 - s01 * x0) / det, 0.0, 255.0);
   }

   blk = astc_header(12u, 4u, 0u, true);
   const uvec2 codes = uvec2((k0 & 0xffu) | ((k1 & 0xffu) << 8u) | ((k0 & 0xff00u) << 8u) | ((k1 & 0xff00u) << 16u),
                             ((k0 >> 16u) & 0xffu) | (((k1 >> 16u) & 0xffu) << 8u) | (ka << 16u));
   put_endpoints(blk, codes, 8u, ER47);
   const uvec2 c2 = spread2(cw), a2 = spread2(aw);
   put_weights(blk, uvec4(c2.x | (a2.x << 2u), c2.y | (a2.y << 2u), 0u, 0u));
   put_bits(blk, 128u - 64u - 2u, 3u, 2u);
   return err + aerr;
}

#ifndef FIT_IT
#define FIT_IT 3u
#endif

/* ---- direct BC4 / BC5 paths ------------------------------------------- */

/* 16 8-bit values of a BC4-style block, packed 4 per word. */
uvec4 bc4_values(uvec2 w)
{
   uvec4 v = uvec4(0u);
   [[unroll]] for (uint i = 0u; i < 16u; i++)
      v[i >> 2u] |= pal8(w, idx3(w, i)) << (8u * (i & 3u));
   return v;
}

/* 1-D fit of 16 values to the `wr` weight levels between two endpoints
 * quantised with `er`; returns the squared error and the endpoint codes.
 * The weights follow from the codes, see put_w1d. */
float fit1d(uvec4 v8, uint wr, uint er, out uint codes)
{
   float lo = 255.0, hi = 0.0;
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const float a = float((v8[i >> 2u] >> (8u * (i & 3u))) & 0xffu);
      lo = min(lo, a);
      hi = max(hi, a);
   }
   float A0 = lo, A1 = hi, best = 1e30;
   codes = 0u;
   [[dont_unroll]] for (uint it = 0u; it < FIT_IT; it++) {
      float u0, u1;
      const uint c0 = eq(er, A0, u0), c1 = eq(er, A1, u1);
      const float da = u1 - u0;
      float e = 0.0, s00 = 0.0, s01 = 0.0, s11 = 0.0, x0 = 0.0, x1 = 0.0;
      [[unroll]] for (uint i = 0u; i < 16u; i++) {
         const float a = float((v8[i >> 2u] >> (8u * (i & 3u))) & 0xffu);
         float unq;
         wlevel(wr, da != 0.0 ? (a - u0) / da : 0.0, unq);
         const float w = unq / 64.0, iw = 1.0 - w;
         const float r = u0 + da * w - a;
         e += r * r;
         s00 += iw * iw; s01 += iw * w; s11 += w * w;
         x0 += iw * a; x1 += w * a;
      }
      if (e < best) { best = e; codes = c0 | (c1 << 8u); }
      const float det = s00 * s11 - s01 * s01;
      if (abs(det) < 1e-6 || e == 0.0) break;
      A0 = clamp((s11 * x0 - s01 * x1) / det, 0.0, 255.0);
      A1 = clamp((s00 * x1 - s01 * x0) / det, 0.0, 255.0);
   }
   return best;
}

/* Unquantised endpoint for the bit-only ranges used here. */
float unq_code(uint er, uint q)
{
   return float(er == ER63 ? ((q << 2u) | (q >> 4u)) : q);
}

/* Weights of a fit1d result into packed slot stride * i + base, or 5-bit
 * slots for WR31. */
void put_w1d(uvec4 v8, uint wr, uint er, uint codes, uint stride, uint base, inout uvec4 w)
{
   const float u0 = unq_code(er, codes & 0xffu), u1 = unq_code(er, codes >> 8u), da = u1 - u0;
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const float a = float((v8[i >> 2u] >> (8u * (i & 3u))) & 0xffu);
      float unq;
      const uint q = wlevel(wr, da != 0.0 ? (a - u0) / da : 0.0, unq);
      if (wr == WR31) put_bits(w, 5u * i, q, 5u);
      else pk_set(w, stride * i + base, q);
   }
}

uvec4 enc_bc4_direct(uvec4 src)
{
   const uvec4 v8 = bc4_values(src.xy);
   uint codes;
   fit1d(v8, WR31, ER255, codes);
   uvec4 blk = astc_header(0u, 7u, 1u, false);
   put_endpoints(blk, uvec2(codes, 0u), 2u, ER255);
   uvec4 w = uvec4(0u);
   put_w1d(v8, WR31, ER255, codes, 1u, 0u, w);
   put_weights(blk, w);
   return blk;
}

/* BC5 as dual-plane LA: one 1-D fit per channel, in the two dual-plane
 * weight/endpoint splits; returns the better one and its error. */
float enc_bc5_dual(uvec4 r8, uvec4 g8, out uvec4 blk)
{
   uint cr, cg, cr2, cg2;
   float best = fit1d(r8, WR5, ER63, cr) + fit1d(g8, WR5, ER63, cg);
   const float e2 = fit1d(r8, WR4, ER255, cr2) + fit1d(g8, WR4, ER255, cg2);
   const bool q5 = e2 < best;
   const uint wr = q5 ? WR4 : WR5, er = q5 ? ER255 : ER63;
   if (q5) { best = e2; cr = cr2; cg = cg2; }

   uvec4 vals = uvec4(0u);
   put_w1d(r8, wr, er, cr, 2u, 0u, vals);
   put_w1d(g8, wr, er, cg, 2u, 1u, vals);
   blk = astc_header(4u, q5 ? 5u : 6u, 0u, true);
   put_endpoints(blk, uvec2((cr & 0xffffu) | (cg << 16u), 0u), 4u, er);
   uvec4 w = uvec4(0u);
   const uint wbits = ise_write(w, 0u, vals, 32u, q5 ? 0u : 1u, q5 ? 2u : 1u);
   put_weights(blk, w);
   put_bits(blk, 128u - wbits - 2u, 3u, 2u);
   return best;
}

/* Energy off the best line through the (r, g) points: the smaller
 * eigenvalue of their scatter matrix. No single-plane block beats it. */
float rg_off_line(uvec4 r8, uvec4 g8)
{
   vec2 s = vec2(0.0);
   vec3 ss = vec3(0.0);
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const vec2 p = vec2(float((r8[i >> 2u] >> (8u * (i & 3u))) & 0xffu),
                          float((g8[i >> 2u] >> (8u * (i & 3u))) & 0xffu));
      s += p;
      ss += vec3(p.x * p.x, p.x * p.y, p.y * p.y);
   }
   const vec3 c = ss - vec3(s.x * s.x, s.x * s.y, s.y * s.y) / 16.0;
   const float tr = c.x + c.z, df = c.x - c.z;
   return max(0.5 * (tr - sqrt(df * df + 4.0 * c.y * c.y)), 0.0);
}

/* Single-plane LA line for BC5: the (r, g) principal axis in closed form,
 * then the same refits as enc_line on the cached values. 16 levels,
 * 8-bit endpoints. Returns the squared error; the block in blk. */
float enc_bc5_single(uvec4 r8, uvec4 g8, out uvec4 blk)
{
   vec2 s = vec2(0.0);
   vec3 ss = vec3(0.0);
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const vec2 p = vec2(float((r8[i >> 2u] >> (8u * (i & 3u))) & 0xffu),
                          float((g8[i >> 2u] >> (8u * (i & 3u))) & 0xffu));
      s += p;
      ss += vec3(p.x * p.x, p.x * p.y, p.y * p.y);
   }
   const vec2 mean = s / 16.0;
   const vec3 c = ss / 16.0 - vec3(mean.x * mean.x, mean.x * mean.y, mean.y * mean.y);
   const float lmax = 0.5 * (c.x + c.z + sqrt((c.x - c.z) * (c.x - c.z) + 4.0 * c.y * c.y));
   vec2 axis = abs(c.y) > 1e-6 ? vec2(lmax - c.z, c.y) : (c.x >= c.z ? vec2(1.0, 0.0) : vec2(0.0, 1.0));
   axis = normalize(axis);
   float tmin = 1e9, tmax = -1e9;
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const vec2 p = vec2(float((r8[i >> 2u] >> (8u * (i & 3u))) & 0xffu),
                          float((g8[i >> 2u] >> (8u * (i & 3u))) & 0xffu));
      const float t = dot(p - mean, axis);
      tmin = min(tmin, t);
      tmax = max(tmax, t);
   }
   vec2 e0 = mean + axis * tmin, e1 = mean + axis * tmax;

   float best = 1e30;
   uint bcodes = 0u;
   [[dont_unroll]] for (uint it = 0u; it < 3u; it++) {
      const uvec2 k0 = uvec2(clamp(e0, 0.0, 255.0) + 0.5), k1 = uvec2(clamp(e1, 0.0, 255.0) + 0.5);
      const vec2 q0 = vec2(k0), d = vec2(k1) - q0;
      const float dd = dot(d, d);
      float e = 0.0, s00 = 0.0, s01 = 0.0, s11 = 0.0;
      vec2 x0 = vec2(0.0), x1 = vec2(0.0);
      [[unroll]] for (uint i = 0u; i < 16u; i++) {
         const vec2 p = vec2(float((r8[i >> 2u] >> (8u * (i & 3u))) & 0xffu),
                             float((g8[i >> 2u] >> (8u * (i & 3u))) & 0xffu));
         float unq;
         wlevel(WR15, dd > 0.0 ? dot(p - q0, d) / dd : 0.0, unq);
         const float w = unq / 64.0, iw = 1.0 - w;
         const vec2 r = q0 + d * w - p;
         e += dot(r, r);
         s00 += iw * iw; s01 += iw * w; s11 += w * w;
         x0 += iw * p; x1 += w * p;
      }
      if (e < best) { best = e; bcodes = k0.x | (k1.x << 8u) | (k0.y << 16u) | (k1.y << 24u); }
      const float det = s00 * s11 - s01 * s01;
      if (abs(det) <= 1e-6) break;
      e0 = clamp((s11 * x0 - s01 * x1) / det, 0.0, 255.0);
      e1 = clamp((s00 * x1 - s01 * x0) / det, 0.0, 255.0);
   }

   blk = astc_header(4u, 4u, 1u, false);
   put_endpoints(blk, uvec2(bcodes, 0u), 4u, ER255);
   const vec2 q0 = vec2(float(bcodes & 0xffu), float((bcodes >> 16u) & 0xffu));
   const vec2 d = vec2(float((bcodes >> 8u) & 0xffu), float(bcodes >> 24u)) - q0;
   const float dd = dot(d, d);
   uvec4 w = uvec4(0u);
   [[unroll]] for (uint i = 0u; i < 16u; i++) {
      const vec2 p = vec2(float((r8[i >> 2u] >> (8u * (i & 3u))) & 0xffu),
                          float((g8[i >> 2u] >> (8u * (i & 3u))) & 0xffu));
      float unq;
      put_bits(w, 4u * i, wlevel(WR15, dd > 0.0 ? dot(p - q0, d) / dd : 0.0, unq), 4u);
   }
   put_weights(blk, w);
   return best;
}

/* ---- per-format entry ---------------------------------------------- */

uvec4 encode_block(uvec4 src, int format)
{
   uvec4 blk, cand;

   if (format == VK_FORMAT_BC4_UNORM_BLOCK)
      return enc_bc4_direct(src);
   if (format == VK_FORMAT_BC5_UNORM_BLOCK) {
      const uvec4 r8 = bc4_values(src.xy), g8 = bc4_values(src.zw);
      float e = enc_bc5_dual(r8, g8, blk);
      if (e > rg_off_line(r8, g8)) {
         float e2 = enc_bc5_single(r8, g8, cand);
         if (e2 < e) blk = cand;
      }
      return blk;
   }

   const bool bc1 = format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK;
   const bool rgb_only = format <= VK_FORMAT_BC1_RGB_SRGB_BLOCK;
   const bool bc2 = format == VK_FORMAT_BC2_UNORM_BLOCK || format == VK_FORMAT_BC2_SRGB_BLOCK;
   const uvec2 cw = bc1 ? src.xy : src.zw;
   const uvec2 aw = src.xy;
   const uint c0 = cw.x & 0xffffu, c1 = cw.x >> 16u, idx = cw.y;
   const bool four = !bc1 || c0 > c1;
   const uint lo = idx & M55, hi = (idx >> 1u) & M55;
   const bool has3 = !four && (lo & hi) != 0u;

   uint amin = 255u, amax = 255u;
   if (!bc1) {
      amin = 255u; amax = 0u;
      for (uint i = 0u; i < 16u; i++) {
         uint a = bc2 ? ((aw[i >> 3u] >> ((i & 7u) * 4u)) & 15u) * 17u : pal8(aw, idx3(aw, i));
         amin = min(amin, a);
         amax = max(amax, a);
      }
   }

   if (amin == amax && !has3) {
      /* Exact: BC endpoints become ASTC endpoints, BC indices weights. */
      uvec3 e0 = dec565(c0), e1 = dec565(c1);
      const bool opaque = amin == 255u;
      blk = astc_header(opaque ? 8u : 12u, four ? 4u : 3u, 0u, false);
      bool swap = e1.r + e1.g + e1.b < e0.r + e0.g + e0.b;
      if (swap) { uvec3 t = e0; e0 = e1; e1 = t; }
      uint ev[8] = uint[](e0.r, e1.r, e0.g, e1.g, e0.b, e1.b, amin, amin);
      for (uint k = 0u; k < (opaque ? 6u : 8u); k++)
         put_bits(blk, 17u + 8u * k, ev[k], 8u);
      uvec4 w = uvec4(0u);
      if (four) {
         /* index 0 1 2 3 -> weight 0 3 1 2 */
         w.x = (lo << 1u) | (lo ^ hi);
         if (swap) w.x = ~w.x;
      } else {
         /* index 0 1 2 -> weight 0 2 1 (range 0..2) */
         uvec4 vals = uvec4(0u);
         for (uint i = 0u; i < 16u; i++) {
            uint v = 2u * ((lo >> (2u * i)) & 1u) + ((hi >> (2u * i)) & 1u);
            pk_set(vals, i, swap ? 2u - v : v);
         }
         ise_write(w, 0u, vals, 16u, 0u, 1u);
      }
      put_weights(blk, w);
      return blk;
   }

   if (bc1 && (lo & hi) == M55)
      return uvec4(0xfffffdfcu, 0xffffffffu, 0u, rgb_only ? 0xffff0000u : 0u);
   if (bc1 && rgb_only) {
      enc_line(src, format, 8u, false, WR15, ER191, 1e30, blk);
      return blk;
   }
   float e;
   if (bc1) {
      e = enc_line(src, format, 12u, true, WR3, ER47, 1e30, blk);
   } else {
      e = enc_alpha_dual(src, bc2, blk);
   }
   /* BC1 punch-through keeps the dual-plane fit: the single-plane retry cost
    * 45% more time for 0.05 dB. */
   if (e > 0.0 && !bc1) {
      float e2 = enc_line(src, format, 12u, false, WR15, ER47, e, cand);
      if (e2 < e) blk = cand;
   }
   return blk;
}

void main()
{
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    uint bz = gl_GlobalInvocationID.z;

    uint num_blocks_x = uint((registers.width + 3) / 4);
    uint num_blocks_y = uint((registers.height + 3) / 4);

    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
        return;

    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);
    int format = SPEC_FORMAT != 0 ? SPEC_FORMAT : registers.format;

    bool half_block = format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK || format == VK_FORMAT_BC4_UNORM_BLOCK;
    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * (half_block ? 2u : 4u);
    uvec4 src = uvec4(ibuf.data[in_word], ibuf.data[in_word + 1u], 0u, 0u);
    if (!half_block)
        src.zw = uvec2(ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);

    uvec4 astc = encode_block(src, format);

    uint out_word = registers.dst_tiled != 0u
        ? (bz * registers.dst_slice_B +
           utile_offset_B(registers.dst_x0 + bx, registers.dst_y0 + by, 2u, 16u)) / 4u
        : (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
    obuf.data[out_word + 0u] = astc.x;
    obuf.data[out_word + 1u] = astc.y;
    obuf.data[out_word + 2u] = astc.z;
    obuf.data[out_word + 3u] = astc.w;
}
