#define VK_FORMAT_BC1_RGB_UNORM_BLOCK 131
#define VK_FORMAT_BC1_RGB_SRGB_BLOCK 132
#define VK_FORMAT_BC1_RGBA_UNORM_BLOCK 133
#define VK_FORMAT_BC1_RGBA_SRGB_BLOCK 134
#define VK_FORMAT_BC2_UNORM_BLOCK 135
#define VK_FORMAT_BC2_SRGB_BLOCK 136
#define VK_FORMAT_BC3_UNORM_BLOCK 137
#define VK_FORMAT_BC3_SRGB_BLOCK 138
#define VK_FORMAT_BC4_UNORM_BLOCK 139
#define VK_FORMAT_BC5_UNORM_BLOCK 141

const uint M55 = 0x55555555u;

/* ---- bit streams --------------------------------------------------- */

void put_bits(inout uvec4 b, uint off, uint v, uint n)
{
   v &= (1u << n) - 1u;
   uint s = off & 31u;
   uint lo = v << s;
   uint hi = s == 0u ? 0u : v >> (32u - s);
   switch (off >> 5u) {
   case 0u: b.x |= lo; b.y |= hi; break;
   case 1u: b.y |= lo; b.z |= hi; break;
   case 2u: b.z |= lo; b.w |= hi; break;
   default: b.w |= lo; break;
   }
}

/* Packed small values: 8 x 4 bits per word. */
uint pk_get(uvec4 p, uint i)
{
   return (p[i >> 3u] >> ((i & 7u) * 4u)) & 15u;
}

void pk_set(inout uvec4 p, uint i, uint v)
{
   p[i >> 3u] |= v << ((i & 7u) * 4u);
}

/* Integer sequence encoding of `count` packed values; kind 1 trits, 2 quints. */
uint ise_write(inout uvec4 b, uint off, uvec4 vals, uint count, uint nb, uint kind)
{
   const uint gs = kind == 1u ? 5u : 3u;
   const uint mask = (1u << nb) - 1u;
   for (uint g = 0u; g < count; g += gs) {
      uint t0 = 0u, t1 = 0u, t2 = 0u, t3 = 0u, t4 = 0u;
      uint n = min(gs, count - g);
      for (uint j = 0u; j < n; j++) {
         uint t = pk_get(vals, g + j) >> nb;
         if (j == 0u) t0 = t; else if (j == 1u) t1 = t; else if (j == 2u) t2 = t;
         else if (j == 3u) t3 = t; else t4 = t;
      }
      uint packed = kind == 1u ? TRIT_PACK[t0 + 3u * t1 + 9u * t2 + 27u * t3 + 81u * t4]
                               : QUINT_PACK[t0 + 5u * t1 + 25u * t2];
      uint shift = 0u;
      for (uint j = 0u; j < n; j++) {
         put_bits(b, off, pk_get(vals, g + j) & mask, nb);
         off += nb;
         uint tb = kind == 1u ? ((j == 2u || j == 4u) ? 1u : 2u) : (j == 0u ? 3u : 2u);
         put_bits(b, off, packed >> shift, tb);
         off += tb;
         shift += tb;
      }
   }
   return off;
}

/* Header: 4x4 weight grid, one partition. R/H select the weight range. */
uvec4 astc_header(uint cem, uint R, uint H, bool dual)
{
   uint mode = ((R >> 1u) & 3u) | ((R & 1u) << 4u) | (2u << 5u) | (H << 9u) |
               (dual ? (1u << 10u) : 0u);
   return uvec4(mode | (cem << 13u), 0u, 0u, 0u);
}

/* Weights are stored bit-reversed from the top of the block. */
void put_weights(inout uvec4 b, uvec4 w)
{
   b |= uvec4(bitfieldReverse(w.w), bitfieldReverse(w.z),
              bitfieldReverse(w.y), bitfieldReverse(w.x));
}

/* ---- quantisation ---------------------------------------------------- */

/* Weight unquantisation (0..64) for the bit-only ranges. */
uint wq_bits(uint v, uint nb)
{
   uint r = nb == 2u ? v * 21u :
            nb == 3u ? ((v << 3u) | v) :
            nb == 4u ? ((v << 2u) | (v >> 2u)) :
                       ((v << 1u) | (v >> 4u));
   if (nb == 2u) r = v == 3u ? 63u : r;
   return r > 32u ? r + 1u : r;
}

/* Nearest level in a bit-only weight range for t in [0, 1]. */
uint wnear_bits(float t, uint nb)
{
   const uint mx = (1u << nb) - 1u;
   float x = clamp(t, 0.0, 1.0) * 64.0;
   uint v = uint(clamp(t, 0.0, 1.0) * float(mx) + 0.5);
   uint best = v;
   float be = abs(float(wq_bits(v, nb)) - x);
   if (v > 0u && abs(float(wq_bits(v - 1u, nb)) - x) < be) { best = v - 1u; be = abs(float(wq_bits(v - 1u, nb)) - x); }
   if (v < mx && abs(float(wq_bits(v + 1u, nb)) - x) < be) best = v + 1u;
   return best;
}

/* 0..4 (quint, linear) and 0..5 (trit + bit) weight ranges. */
const uint W5_UNQ[6] = uint[](0u, 12u, 25u, 39u, 52u, 64u);   /* by rank */
const uint W5_ISE[6] = uint[](0u, 2u, 4u, 5u, 3u, 1u);         /* rank -> ISE */

uint wnear_q5(float t) { return uint(clamp(t, 0.0, 1.0) * 4.0 + 0.5); }

uint wnear_t6(float t)
{
   float x = clamp(t, 0.0, 1.0) * 64.0;
   uint best = 0u;
   float be = 1e9;
   for (uint k = 0u; k < 6u; k++) {
      float e = abs(float(W5_UNQ[k]) - x);
      if (e < be) { be = e; best = k; }
   }
   return best;
}

/* ---- BC decoding helpers --------------------------------------------- */

uvec3 dec565(uint c)
{
   uint r = (c >> 11u) & 31u, g = (c >> 5u) & 63u, b = c & 31u;
   return uvec3((r << 3u) | (r >> 2u), (g << 2u) | (g >> 4u), (b << 3u) | (b >> 2u));
}

/* 3-bit index of texel i from a BC3-alpha / BC4 block (index bits start at 16). */
uint idx3(uvec2 w, uint i)
{
   uint pos = 16u + 3u * i;
   if (pos + 3u <= 32u) return (w.x >> pos) & 7u;
   if (pos >= 32u) return (w.y >> (pos - 32u)) & 7u;
   return ((w.x >> pos) | (w.y << (32u - pos))) & 7u;
}

/* BC3-alpha / BC4 palette entry k (8-bit). */
uint pal8(uvec2 w, uint k)
{
   uint a0 = w.x & 0xffu, a1 = (w.x >> 8u) & 0xffu;
   if (k == 0u) return a0;
   if (k == 1u) return a1;
   if (a0 > a1) return (a0 * (8u - k) + a1 * (k - 1u) + 3u) / 7u;
   if (k == 6u) return 0u;
   if (k == 7u) return 255u;
   return (a0 * (6u - k) + a1 * (k - 1u) + 2u) / 5u;
}

uint e127(uint v) { return (v * 127u + 127u) / 255u; }
uint e127_unq(uint q) { return (q << 1u) | (q >> 6u); }

/* ---- BC7: block-oriented decode ------------------------------------- */

/* Per mode: subsets, partition bits, rotation bits, index-select bit,
 * colour bits, alpha bits, per-endpoint p-bit, shared p-bit, index bits,
 * second index bits. */
const uint BC7_NS[8]  = uint[](3u, 2u, 3u, 2u, 1u, 1u, 1u, 2u);
const uint BC7_PB[8]  = uint[](4u, 6u, 6u, 6u, 0u, 0u, 0u, 6u);
const uint BC7_RB[8]  = uint[](0u, 0u, 0u, 0u, 2u, 2u, 0u, 0u);
const uint BC7_ISB[8] = uint[](0u, 0u, 0u, 0u, 1u, 0u, 0u, 0u);
const uint BC7_CB[8]  = uint[](4u, 6u, 5u, 7u, 5u, 7u, 7u, 5u);
const uint BC7_AB[8]  = uint[](0u, 0u, 0u, 0u, 6u, 8u, 7u, 5u);
const uint BC7_EPB[8] = uint[](1u, 0u, 0u, 1u, 0u, 0u, 1u, 1u);
const uint BC7_SPB[8] = uint[](0u, 1u, 0u, 0u, 0u, 0u, 0u, 0u);
const uint BC7_IB[8]  = uint[](3u, 3u, 2u, 2u, 2u, 2u, 4u, 2u);
const uint BC7_IB2[8] = uint[](0u, 0u, 0u, 0u, 3u, 2u, 0u, 0u);

/* Decoded once per block. Endpoint k = 2 * subset + {0,1}, RGBA8 packed. */
uint g7_mode, g7_part, g7_rot, g7_isb, g7_ns, g7_idx;
uint g7_ep[6];

uint bits_at(uvec4 p, uint off, uint n)
{
   uint w = off >> 5u, s = off & 31u;
   uint v = p[w] >> s;
   if (s + n > 32u && w < 3u)
      v |= p[w + 1u] << (32u - s);
   return v & ((1u << n) - 1u);
}

uint bc7_unq(uint v, uint n)
{
   v <<= 8u - n;
   return v | (v >> n);
}

void bc7_setup(uvec4 p)
{
   const uint m8 = p.x & 0xffu;
   g7_mode = m8 == 0u ? 8u : uint(findLSB(m8));
   if (g7_mode == 8u) {
      /* reserved: decodes to transparent black */
      for (uint k = 0u; k < 6u; k++) g7_ep[k] = 0u;
      g7_ns = 1u; g7_part = 0u; g7_rot = 0u; g7_isb = 0u; g7_idx = 0u;
      return;
   }
   const uint m = g7_mode;
   uint off = m + 1u;
   g7_part = bits_at(p, off, BC7_PB[m]); off += BC7_PB[m];
   g7_rot = bits_at(p, off, BC7_RB[m]); off += BC7_RB[m];
   g7_isb = bits_at(p, off, BC7_ISB[m]); off += BC7_ISB[m];
   g7_ns = BC7_NS[m];
   const uint ne = 2u * g7_ns, cb = BC7_CB[m], ab = BC7_AB[m];

   uint raw[6];
   for (uint k = 0u; k < 6u; k++) raw[k] = 0u;
   for (uint c = 0u; c < 3u; c++)
      for (uint k = 0u; k < ne; k++) {
         raw[k] |= bits_at(p, off, cb) << (8u * c);
         off += cb;
      }
   for (uint k = 0u; k < ne; k++) {
      if (ab > 0u) {
         raw[k] |= bits_at(p, off, ab) << 24u;
         off += ab;
      }
   }
   uint pb[6] = uint[](0u, 0u, 0u, 0u, 0u, 0u);
   if (BC7_EPB[m] != 0u) {
      for (uint k = 0u; k < ne; k++) { pb[k] = bits_at(p, off, 1u); off += 1u; }
   } else if (BC7_SPB[m] != 0u) {
      for (uint s = 0u; s < g7_ns; s++) {
         uint b = bits_at(p, off, 1u); off += 1u;
         pb[2u * s] = b; pb[2u * s + 1u] = b;
      }
   }
   const bool has_pb = BC7_EPB[m] != 0u || BC7_SPB[m] != 0u;
   for (uint k = 0u; k < 6u; k++) {
      uint e = 0u;
      if (k < ne) {
         for (uint c = 0u; c < 4u; c++) {
            uint n = c < 3u ? cb : ab;
            uint v;
            if (n == 0u) {
               v = 255u;
            } else {
               v = (raw[k] >> (8u * c)) & ((1u << n) - 1u);
               if (has_pb) { v = (v << 1u) | pb[k]; n += 1u; }
               v = bc7_unq(v, n);
            }
            e |= v << (8u * c);
         }
      }
      g7_ep[k] = e;
   }
   g7_idx = off;
}

/* The encoder reads each texel several times per pass: decode them once
 * per block. */
shared uint s7_tex[16u * 64u];

/* 64 bits of p starting at bit off (off < 128). */
uvec2 bits64_at(uvec4 p, uint off)
{
   const uint w = off >> 5u, s = off & 31u;
   const uint a = p[w], b = w < 3u ? p[w + 1u] : 0u, c = w < 2u ? p[w + 2u] : 0u;
   return s == 0u ? uvec2(a, b) : uvec2((a >> s) | (b << (32u - s)), (b >> s) | (c << (32u - s)));
}

/* Next n bits of a 64-bit stream (lo, hi), advancing it. */
uint take(inout uvec2 st, uint n)
{
   const uint v = st.x & ((1u << n) - 1u);
   st = n == 0u ? st : uvec2((st.x >> n) | (st.y << (32u - n)), st.y >> n);
   return v;
}

/* BC7 interpolation weight for index v of an n-bit index: the BC7 weight
 * tables are round(v * 64 / (2^n - 1)). */
uint bc7_w(uint v, uint n)
{
   return uint(float(v) * (64.0 / float((1u << n) - 1u)) + 0.5);
}

void bc7_cache(uvec4 p)
{
   if (g7_mode == 8u) {
      for (uint i = 0u; i < 16u; i++) s7_tex[i * 64u + gl_LocalInvocationIndex] = 0u;
      return;
   }
   const uint m = g7_mode, ib = BC7_IB[m], ib2 = BC7_IB2[m];
   /* per block: subset map, anchors, endpoints, index streams */
   const uint pmap = g7_ns == 2u ? uint(partition_table2[g7_part]) :
                     g7_ns == 3u ? uint(partition_table3[g7_part]) : 0u;
   const uint a1 = g7_ns == 2u ? uint(anchor_table2[g7_part]) : g7_ns == 3u ? uint(anchor_table3[g7_part].x) : 99u;
   const uint a2 = g7_ns == 3u ? uint(anchor_table3[g7_part].y) : 99u;
   uvec2 st = bits64_at(p, g7_idx);
   if (ib2 == 0u) {
      /* One weight for all channels and no rotation: interpolate R/B and
       * G/A two lanes per word; the result is already packed RGBA8. */
      const uvec3 rb0 = uvec3(g7_ep[0], g7_ep[2], g7_ep[4]) & 0x00ff00ffu;
      const uvec3 rb1 = uvec3(g7_ep[1], g7_ep[3], g7_ep[5]) & 0x00ff00ffu;
      const uvec3 ga0 = (uvec3(g7_ep[0], g7_ep[2], g7_ep[4]) >> 8u) & 0x00ff00ffu;
      const uvec3 ga1 = (uvec3(g7_ep[1], g7_ep[3], g7_ep[5]) >> 8u) & 0x00ff00ffu;
      for (uint i = 0u; i < 16u; i++) {
         const bool anc = i == 0u || i == a1 || i == a2;
         const uint w = bc7_w(take(st, ib - (anc ? 1u : 0u)), ib);
         const uint sub = g7_ns == 3u ? (pmap >> (2u * i)) & 3u : (pmap >> i) & 1u;
         const uint r0 = sub == 0u ? rb0.x : sub == 1u ? rb0.y : rb0.z;
         const uint r1 = sub == 0u ? rb1.x : sub == 1u ? rb1.y : rb1.z;
         const uint g0 = sub == 0u ? ga0.x : sub == 1u ? ga0.y : ga0.z;
         const uint g1 = sub == 0u ? ga1.x : sub == 1u ? ga1.y : ga1.z;
         const uint rb = (((64u - w) * r0 + w * r1 + 0x00200020u) >> 6u) & 0x00ff00ffu;
         const uint ga = (((64u - w) * g0 + w * g1 + 0x00200020u) >> 6u) & 0x00ff00ffu;
         s7_tex[i * 64u + gl_LocalInvocationIndex] = rb | (ga << 8u);
      }
      return;
   }
   uvec2 st2 = ib2 != 0u ? bits64_at(p, g7_idx + 16u * ib - 1u) : uvec2(0u);
   const bool swapw = m == 4u && g7_isb != 0u;
   for (uint i = 0u; i < 16u; i++) {
      const bool anc = i == 0u || i == a1 || i == a2;
      const uint i1 = take(st, ib - (anc ? 1u : 0u));
      uint wc = bc7_w(i1, ib), wa = wc;
      if (ib2 != 0u) {
         const uint w2 = bc7_w(take(st2, ib2 - (i == 0u ? 1u : 0u)), ib2);
         if (swapw) wc = w2; else wa = w2;
      }
      const uint sub = g7_ns == 3u ? (pmap >> (2u * i)) & 3u : (pmap >> i) & 1u;
      const uint q0 = sub == 0u ? g7_ep[0] : sub == 1u ? g7_ep[2] : g7_ep[4];
      const uint q1 = sub == 0u ? g7_ep[1] : sub == 1u ? g7_ep[3] : g7_ep[5];
      const uvec4 e0 = (uvec4(q0) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu;
      const uvec4 e1 = (uvec4(q1) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu;
      const uvec4 w = uvec4(wc, wc, wc, wa);
      uvec4 c = ((64u - w) * e0 + w * e1 + 32u) >> 6u;
      if (g7_rot == 1u) c = c.agbr;
      else if (g7_rot == 2u) c = c.rabg;
      else if (g7_rot == 3u) c = c.rgab;
      s7_tex[i * 64u + gl_LocalInvocationIndex] = c.r | (c.g << 8u) | (c.b << 16u) | (c.a << 24u);
   }
}

vec4 bc_texel(uvec4 p, int format, uint i)
{
   return vec4((uvec4(s7_tex[i * 64u + gl_LocalInvocationIndex]) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu);
}
/* ---- generic quantisers ---------------------------------------------- */

#define WR3  0u /* 0..3  bits  */
#define WR4  1u /* 0..4  quint */
#define WR5  2u /* 0..5  trit  */
#define WR15 3u /* 0..15 bits  */
#define WR31 4u /* 0..31 bits  */
#define ER47  0u
#define ER191 1u
#define ER63  2u
#define ER255 3u

/* Weight level for t in [0,1]: returns ISE value, unq (0..64) out. */
uint wlevel(uint wr, float t, out float unq)
{
   uint v;
   if (wr == WR4) {
      v = wnear_q5(t);
      unq = float(v * 16u);
      return v;
   }
   if (wr == WR5) {
      uint r = wnear_t6(t);
      unq = float(W5_UNQ[r]);
      return W5_ISE[r];
   }
   uint nb = wr == WR3 ? 2u : wr == WR15 ? 4u : 5u;
   v = wnear_bits(t, nb);
   unq = float(wq_bits(v, nb));
   return v;
}

/* Endpoint quantisation of v (0..255): returns ISE code, unq out. */
uint eq(uint er, float v, out float unq)
{
   uint x = uint(clamp(v, 0.0, 255.0) + 0.5);
   if (er == ER255) { unq = float(x); return x; }
   if (er == ER63) {
      uint q = (x * 63u + 127u) / 255u;
      unq = float((q << 2u) | (q >> 4u));
      return q;
   }
   uint l = er == ER47 ? E47_LUT[x] : E191_LUT[x];
   unq = float(l >> 8u);
   return l & 0xffu;
}

/* Write up to 8 endpoint codes (8 bits each, packed in uvec2). */
void put_endpoints(inout uvec4 b, uvec2 codes, uint count, uint er)
{
   uint off = 17u;
   if (er == ER255 || er == ER63) {
      uint nb = er == ER255 ? 8u : 6u;
      for (uint k = 0u; k < count; k++) {
         put_bits(b, off, (codes[k >> 2u] >> (8u * (k & 3u))) & 0xffu, nb);
         off += nb;
      }
      return;
   }
   const uint nb = er == ER47 ? 4u : 6u;
   for (uint g = 0u; g < count; g += 5u) {
      uint n = min(5u, count - g);
      uint t[5] = uint[](0u, 0u, 0u, 0u, 0u);
      for (uint j = 0u; j < n; j++)
         t[j] = ((codes[(g + j) >> 2u] >> (8u * ((g + j) & 3u))) & 0xffu) >> nb;
      uint packed = TRIT_PACK[t[0] + 3u * t[1] + 9u * t[2] + 27u * t[3] + 81u * t[4]];
      uint shift = 0u;
      for (uint j = 0u; j < n; j++) {
         uint c = (codes[(g + j) >> 2u] >> (8u * ((g + j) & 3u))) & 0xffu;
         put_bits(b, off, c, nb);
         off += nb;
         uint tb = (j == 2u || j == 4u) ? 1u : 2u;
         put_bits(b, off, packed >> shift, tb);
         off += tb;
         shift += tb;
      }
   }
}

/* ---- streaming line encoder ------------------------------------------ */

/* Map a texel into endpoint-channel space: LA modes carry (x, y) in L, A. */
vec4 chan(vec4 t, uint cem)
{
   return cem == 4u ? vec4(t.r, t.g, 0.0, 0.0) : cem == 0u ? vec4(t.r, 0.0, 0.0, 0.0) : t;
}

/* What the decoder returns for channel space value d (channels >= nch). */
vec4 fill(vec4 d, uint cem)
{
   if (cem == 8u) d.a = 255.0;
   return d;
}

/* Principal-axis fit + least-squares refit, single or dual plane (second
 * plane = channel p1). Returns squared error; the block in blk. */
float enc_line(uvec4 src, int format, uint cem, bool dual, uint wr, uint er, float skip_if,
               bool seeded, vec4 s0, vec4 s1, uint ccs, out uvec4 blk)
{
   const uint nch = cem == 0u ? 1u : cem == 4u ? 2u : cem == 8u ? 3u : 4u;
   const uint p1 = cem == 4u ? 1u : ccs;
   const vec4 cm = vec4(1.0, nch > 1u ? 1.0 : 0.0, nch > 2u ? 1.0 : 0.0, nch > 3u ? 1.0 : 0.0);
   vec4 m1 = vec4(0.0);
   if (dual) m1[p1] = 1.0;
   const vec4 m0 = cm - m1;

   /* Seeded callers already know the line (BC7 single-subset modes): start
    * the refits on it instead of fitting one. */
   vec4 e0 = s0, e1 = s1;
   if (!seeded) {
      /* One pass: sums for the mean and the covariance (E[pp^T] - mean mean^T),
       * texels scaled to 0..1 to keep the sums small. */
      vec4 mean = vec4(0.0);
      mat4 cov = mat4(0.0);
      float amin = 1e9, amax = -1e9;
      vec4 lo = vec4(1e9), hi = vec4(-1e9);
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         vec4 p = chan(bc_texel(src, format, i), cem);
         vec4 s = p * (1.0 / 255.0) * m0;
         mean += p;
         cov += outerProduct(s, s);
         float a = dot(p, m1);
         amin = min(amin, a);
         amax = max(amax, a);
         lo = min(lo, p);
         hi = max(hi, p);
      }
      mean *= 1.0 / 16.0;
      {
         vec4 ms = mean * (1.0 / 255.0) * m0;
         cov = cov - outerProduct(ms, ms) * 16.0;
      }
      vec4 axis = (hi - lo) * m0;
      vec4 row = cov * axis;
      axis = dot(row, row) > 1e-6 ? row : axis;
      for (uint it = 0u; it < 2u; it++) {
         vec4 nx = cov * axis;
         float l = dot(nx, nx);
         if (l < 1e-12) break;
         axis = nx * inversesqrt(l);
      }
      axis = dot(axis, axis) > 1e-12 ? normalize(axis) : m0 * 0.5;
      {
         /* Every single-line encoding errs by at least the energy off the best
          * line: stop when that already loses to the caller's candidate. */
         const float lam = dot(axis, cov * axis) / max(dot(axis, axis), 1e-12);
         const float off = (cov[0][0] + cov[1][1] + cov[2][2] + cov[3][3] - lam) * 65025.0;
         if (off >= skip_if) { blk = uvec4(0u); return 1e30; }
      }

      float tmin = 1e9, tmax = -1e9;
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         float t = dot((chan(bc_texel(src, format, i), cem) - mean) * m0, axis);
         tmin = min(tmin, t);
         tmax = max(tmax, t);
      }
      e0 = (mean + axis * tmin) * m0 + m1 * amin;
      e1 = (mean + axis * tmax) * m0 + m1 * amax;
   }

   float best = 1e30;
   vec4 bq0 = vec4(0.0), bq1 = vec4(0.0);
   uvec2 bc = uvec2(0u);

   for (uint iter = 0u; iter < 1u; iter++) {
      vec4 q0 = vec4(0.0), q1 = vec4(0.0);
      uint c0 = 0u, c1 = 0u;  /* codes, 8 bits per channel */
      for (uint c = 0u; c < nch; c++) {
         float u;
         c0 |= eq(er, e0[c], u) << (8u * c); q0[c] = u;
         c1 |= eq(er, e1[c], u) << (8u * c); q1[c] = u;
      }
      if (cem >= 8u && q1.r + q1.g + q1.b < q0.r + q0.g + q0.b) {
         vec4 tq = q0; q0 = q1; q1 = tq;
         uint tc = c0; c0 = c1; c1 = tc;
      }
      const vec4 d0 = (q1 - q0) * m0;
      const float dd = dot(d0, d0);
      const float d1 = dot(q1 - q0, m1);

      float err = 0.0;
      float a = 0.0, b = 0.0, cc = 0.0, aa = 0.0, ab = 0.0, ac = 0.0;
      vec4 x0 = vec4(0.0), x1 = vec4(0.0);
      float ax0 = 0.0, ax1 = 0.0;
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         vec4 t4 = bc_texel(src, format, i);
         vec4 p = chan(t4, cem);
         float u0, u1 = 0.0;
         wlevel(wr, dd > 0.0 ? dot((p - q0) * m0, d0) / dd : 0.0, u0);
         float w0 = u0 / 64.0, w1 = 0.0;
         vec4 dec = q0 + (q1 - q0) * w0;
         if (dual) {
            wlevel(wr, d1 != 0.0 ? (dot(p, m1) - dot(q0, m1)) / d1 : 0.0, u1);
            w1 = u1 / 64.0;
            dec = dec * (vec4(1.0) - m1) + (q0 + (q1 - q0) * w1) * m1;
         }
         vec4 full = fill(dec * cm, cem);
         vec4 ref = cem == 8u ? t4 : p;
         vec4 diff = full - (cem == 8u ? ref : ref * cm);
         err += dot(diff, diff);
         float iw = 1.0 - w0;
         a += iw * iw; b += iw * w0; cc += w0 * w0;
         x0 += iw * p; x1 += w0 * p;
         if (dual) {
            float iw1 = 1.0 - w1;
            aa += iw1 * iw1; ab += iw1 * w1; ac += w1 * w1;
            ax0 += iw1 * dot(p, m1); ax1 += w1 * dot(p, m1);
         }
      }
      if (err < best) {
         best = err;
         bq0 = q0; bq1 = q1;
         bc = uvec2(0u);
         /* interleave codes: c0[ch], c1[ch] for each channel */
         for (uint c = 0u; c < nch; c++) {
            uint k0 = 2u * c, k1 = 2u * c + 1u;
            bc[k0 >> 2u] |= ((c0 >> (8u * c)) & 0xffu) << (8u * (k0 & 3u));
            bc[k1 >> 2u] |= ((c1 >> (8u * c)) & 0xffu) << (8u * (k1 & 3u));
         }
      }
      float det = a * cc - b * b;
      if (abs(det) > 1e-6) {
         e0 = clamp((cc * x0 - b * x1) / det, 0.0, 255.0) * m0;
         e1 = clamp((a * x1 - b * x0) / det, 0.0, 255.0) * m0;
      } else {
         e0 = q0 * m0; e1 = q1 * m0;
      }
      if (dual) {
         float deta = aa * ac - ab * ab;
         float a0 = abs(deta) > 1e-6 ? clamp((ac * ax0 - ab * ax1) / deta, 0.0, 255.0) : dot(q0, m1);
         float a1 = abs(deta) > 1e-6 ? clamp((aa * ax1 - ab * ax0) / deta, 0.0, 255.0) : dot(q1, m1);
         e0 += m1 * a0; e1 += m1 * a1;
      }
   }

   /* Assemble the best candidate. */
   const uint R = wr == WR3 ? 4u : wr == WR4 ? 5u : wr == WR5 ? 6u : wr == WR15 ? 4u : 7u;
   const uint Hb = (wr == WR15 || wr == WR31) ? 1u : 0u;
   blk = astc_header(cem, R, Hb, dual);
   put_endpoints(blk, bc, 2u * nch, er);
   const vec4 d0 = (bq1 - bq0) * m0;
   const float dd = dot(d0, d0);
   const float d1 = dot(bq1 - bq0, m1);
   uvec4 vals = uvec4(0u), w = uvec4(0u);
   uint wbits;
   if (wr == WR31) {
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         vec4 p = chan(bc_texel(src, format, i), cem);
         float u;
         put_bits(w, 5u * i, wlevel(wr, dd > 0.0 ? dot((p - bq0) * m0, d0) / dd : 0.0, u), 5u);
      }
      wbits = 80u;
   } else {
      const uint n = dual ? 32u : 16u;
      [[dont_unroll]] for (uint i = 0u; i < 16u; i++) {
         vec4 p = chan(bc_texel(src, format, i), cem);
         float u;
         uint v0 = wlevel(wr, dd > 0.0 ? dot((p - bq0) * m0, d0) / dd : 0.0, u);
         if (dual) {
            uint v1 = wlevel(wr, d1 != 0.0 ? (dot(p, m1) - dot(bq0, m1)) / d1 : 0.0, u);
            pk_set(vals, 2u * i, v0);
            pk_set(vals, 2u * i + 1u, v1);
         } else {
            pk_set(vals, i, v0);
         }
      }
      if (wr == WR3 || wr == WR15) {
         uint nb = wr == WR3 ? 2u : 4u;
         for (uint k = 0u; k < n; k++)
            put_bits(w, nb * k, pk_get(vals, k), nb);
         wbits = nb * n;
      } else {
         wbits = ise_write(w, 0u, vals, n, wr == WR5 ? 1u : 0u, wr == WR5 ? 1u : 2u);
      }
   }
   put_weights(blk, w);
   if (dual)
      put_bits(blk, 128u - wbits - 2u, p1, 2u);
   return best;
}

/* ---- single-subset modes 5 and 6 -------------------------------------- */

/* Rotated endpoint k as 0..255 per channel. */
uvec4 bc7_rot_ep(uint k)
{
   uvec4 c = (uvec4(g7_ep[k]) >> uvec4(0u, 8u, 16u, 24u)) & 0xffu;
   if (g7_rot == 1u) c = c.agbr;
   else if (g7_rot == 2u) c = c.rabg;
   else if (g7_rot == 3u) c = c.rgab;
   return c;
}

/* Opaque, unrotated mode 5: the colour indices are exactly the ASTC 2-bit
 * weights and 8-bit endpoints fit, so the block transfers losslessly. */
uvec4 enc_bc7_m5_opaque(uvec4 p)
{
   const uvec4 b0 = bc7_rot_ep(0u), b1 = bc7_rot_ep(1u);
   const uint ci = ((p.z >> 2u) | (p.w << 30u)) & 0x7fffffffu;
   uint cw = (ci & 1u) | ((ci & ~1u) << 1u);
   uvec4 c0 = b0, c1 = b1;
   if (b1.r + b1.g + b1.b < b0.r + b0.g + b0.b) { c0 = b1; c1 = b0; cw = ~cw; }
   uvec4 blk = astc_header(8u, 4u, 0u, false);
   put_endpoints(blk, uvec2(c0.r | (c1.r << 8u) | (c0.g << 16u) | (c1.g << 24u), c0.b | (c1.b << 8u)), 6u, ER255);
   put_weights(blk, uvec4(cw, 0u, 0u, 0u));
   return blk;
}

/* Opaque, unrotated blocks: RGB line (CEM 8, 4-bit weights, endpoints in
 * the 0..191 range) in three passes over the cached texels: moments, line
 * extent, then weights (packed as they are found) and the error. */
uvec4 enc_opaque_fast(uvec4 src, int format)
{
   vec3 sum = vec3(0.0);
   vec3 sq = vec3(0.0), cr = vec3(0.0);   /* xx yy zz, xy xz yz */
   vec3 lo = vec3(255.0), hi = vec3(0.0);
   for (uint i = 0u; i < 16u; i++) {
      const vec3 p = bc_texel(src, format, i).rgb;
      const vec3 s = p * (1.0 / 255.0);
      sum += p;
      sq += s * s;
      cr += s.xxy * s.yzz;
      lo = min(lo, p); hi = max(hi, p);
   }
   const vec3 mean = sum * (1.0 / 16.0);
   const vec3 ms = mean * (1.0 / 255.0);
   const mat3 cov = mat3(sq.x - 16.0 * ms.x * ms.x, cr.x - 16.0 * ms.x * ms.y, cr.y - 16.0 * ms.x * ms.z,
                         cr.x - 16.0 * ms.x * ms.y, sq.y - 16.0 * ms.y * ms.y, cr.z - 16.0 * ms.y * ms.z,
                         cr.y - 16.0 * ms.x * ms.z, cr.z - 16.0 * ms.y * ms.z, sq.z - 16.0 * ms.z * ms.z);
   vec3 axis = hi - lo;
   const vec3 row = cov * axis;
   axis = dot(row, row) > 1e-6 ? row : axis;
   for (uint it = 0u; it < 2u; it++) {
      const vec3 nx = cov * axis;
      const float l = dot(nx, nx);
      if (l < 1e-12) break;
      axis = nx * inversesqrt(l);
   }
   axis = dot(axis, axis) > 1e-12 ? normalize(axis) : vec3(0.57735);

   float tmin = 1e9, tmax = -1e9;
   for (uint i = 0u; i < 16u; i++) {
      const float t = dot(bc_texel(src, format, i).rgb - mean, axis);
      tmin = min(tmin, t); tmax = max(tmax, t);
   }
   vec3 e0 = mean + axis * tmin, e1 = mean + axis * tmax;
   /* CEM 8 swaps (and blue-contracts) when the second endpoint is darker */
   if (dot(e1, vec3(1.0)) < dot(e0, vec3(1.0))) { const vec3 t = e0; e0 = e1; e1 = t; }
   vec3 q0, q1;
   uint c0 = 0u, c1 = 0u;
   for (uint c = 0u; c < 3u; c++) {
      float u;
      c0 |= eq(ER191, e0[c], u) << (8u * c); q0[c] = u;
      c1 |= eq(ER191, e1[c], u) << (8u * c); q1[c] = u;
   }
   if (dot(q1, vec3(1.0)) < dot(q0, vec3(1.0))) {
      const vec3 t = q0; q0 = q1; q1 = t;
      const uint tc = c0; c0 = c1; c1 = tc;
   }
   const vec3 d = q1 - q0;
   const float rdd = dot(d, d) > 0.0 ? 15.0 / dot(d, d) : 0.0;
   uvec4 w = uvec4(0u);
   for (uint i = 0u; i < 16u; i++) {
      const vec3 p = bc_texel(src, format, i).rgb;
      const uint v = uint(clamp(dot(p - q0, d) * rdd + 0.5, 0.0, 15.0));
      w[i >> 3u] |= v << (4u * (i & 7u));
   }
   uvec4 blk = astc_header(8u, 4u, 1u, false);
   uvec2 bc = uvec2(0u);
   for (uint c = 0u; c < 3u; c++) {
      const uint k0 = 2u * c, k1 = 2u * c + 1u;
      bc[k0 >> 2u] |= ((c0 >> (8u * c)) & 0xffu) << (8u * (k0 & 3u));
      bc[k1 >> 2u] |= ((c1 >> (8u * c)) & 0xffu) << (8u * (k1 & 3u));
   }
   put_endpoints(blk, bc, 6u, ER191);
   put_weights(blk, w);
   return blk;
}

/* Blocks with alpha (or rotation): one RGBA line (CEM 12, 4-bit weights,
 * endpoints in the 0..47 range), same three passes as the opaque path.
 * Mode 6 is one RGBA line already: its endpoints seed it directly. */
uvec4 enc_rgba_fast(uvec4 src, int format, bool seeded, vec4 s0, vec4 s1)
{
   vec4 e0 = s0, e1 = s1;
   if (!seeded) {
      vec4 sum = vec4(0.0), lo = vec4(255.0), hi = vec4(0.0);
      mat4 pp = mat4(0.0);
      for (uint i = 0u; i < 16u; i++) {
         const vec4 p = bc_texel(src, format, i);
         const vec4 s = p * (1.0 / 255.0);
         sum += p; pp += outerProduct(s, s);
         lo = min(lo, p); hi = max(hi, p);
      }
      const vec4 mean = sum * (1.0 / 16.0), ms = mean * (1.0 / 255.0);
      const mat4 cov = pp - 16.0 * outerProduct(ms, ms);
      vec4 axis = hi - lo;
      const vec4 row = cov * axis;
      axis = dot(row, row) > 1e-6 ? row : axis;
      for (uint it = 0u; it < 2u; it++) {
         const vec4 nx = cov * axis;
         const float l = dot(nx, nx);
         if (l < 1e-12) break;
         axis = nx * inversesqrt(l);
      }
      axis = dot(axis, axis) > 1e-12 ? normalize(axis) : vec4(0.5);
      float tmin = 1e9, tmax = -1e9;
      for (uint i = 0u; i < 16u; i++) {
         const float t = dot(bc_texel(src, format, i) - mean, axis);
         tmin = min(tmin, t); tmax = max(tmax, t);
      }
      e0 = mean + axis * tmin; e1 = mean + axis * tmax;
   }
   if (dot(e1.rgb, vec3(1.0)) < dot(e0.rgb, vec3(1.0))) { const vec4 t = e0; e0 = e1; e1 = t; }
   vec4 q0, q1;
   uvec2 bc = uvec2(0u);
   for (uint c = 0u; c < 4u; c++) {
      float u;
      const uint k0 = 2u * c, k1 = 2u * c + 1u;
      bc[k0 >> 2u] |= eq(ER47, e0[c], u) << (8u * (k0 & 3u)); q0[c] = u;
      bc[k1 >> 2u] |= eq(ER47, e1[c], u) << (8u * (k1 & 3u)); q1[c] = u;
   }
   if (dot(q1.rgb, vec3(1.0)) < dot(q0.rgb, vec3(1.0))) {
      /* quantisation flipped the order: swap the code pairs too */
      const vec4 t = q0; q0 = q1; q1 = t;
      bc = ((bc >> 8u) & 0x00ff00ffu) | ((bc << 8u) & 0xff00ff00u);
   }
   const vec4 d = q1 - q0;
   const float rdd = dot(d, d) > 0.0 ? 15.0 / dot(d, d) : 0.0;
   uvec4 w = uvec4(0u);
   for (uint i = 0u; i < 16u; i++) {
      const uint v = uint(clamp(dot(bc_texel(src, format, i) - q0, d) * rdd + 0.5, 0.0, 15.0));
      w[i >> 3u] |= v << (4u * (i & 7u));
   }
   uvec4 blk = astc_header(12u, 4u, 1u, false);
   put_endpoints(blk, bc, 8u, ER47);
   put_weights(blk, w);
   return blk;
}

/* BC7 modes 4/5 keep one channel (alpha, or the one rotation swapped in)
 * on its own indices: ASTC dual plane (CEM 12, 2-bit weights per plane,
 * endpoints in the 0..47 range) with that channel on the second plane,
 * the other three on one line. */
uvec4 enc_dual_fast(uvec4 src, int format, uint ccs, bool seeded, vec4 s0, vec4 s1)
{
   /* Modes 4/5 are single-subset: after rotation their endpoints are the
    * exact dual-plane line, the separate channel on the second plane. */
   vec4 m1 = vec4(0.0); m1[ccs] = 1.0;
   const vec4 m0 = vec4(1.0) - m1;
   vec4 e0 = s0, e1 = s1;
   if (!seeded) {
      vec4 sum = vec4(0.0), lo = vec4(255.0), hi = vec4(0.0);
      mat4 pp = mat4(0.0);
      for (uint i = 0u; i < 16u; i++) {
         const vec4 p = bc_texel(src, format, i);
         const vec4 s = p * (1.0 / 255.0) * m0;
         sum += p; pp += outerProduct(s, s);
         lo = min(lo, p); hi = max(hi, p);
      }
      const vec4 mean = sum * (1.0 / 16.0), ms = mean * (1.0 / 255.0) * m0;
      const mat4 cov = pp - 16.0 * outerProduct(ms, ms);
      vec4 axis = (hi - lo) * m0;
      const vec4 row = cov * axis;
      axis = dot(row, row) > 1e-6 ? row : axis;
      for (uint it = 0u; it < 2u; it++) {
         const vec4 nx = cov * axis;
         const float l = dot(nx, nx);
         if (l < 1e-12) break;
         axis = nx * inversesqrt(l);
      }
      axis = dot(axis, axis) > 1e-12 ? normalize(axis) : m0 * 0.57735;
      float tmin = 1e9, tmax = -1e9;
      for (uint i = 0u; i < 16u; i++) {
         const float t = dot((bc_texel(src, format, i) - mean) * m0, axis);
         tmin = min(tmin, t); tmax = max(tmax, t);
      }
      e0 = (mean + axis * tmin) * m0 + m1 * dot(lo, m1);
      e1 = (mean + axis * tmax) * m0 + m1 * dot(hi, m1);
   }
   vec4 q0, q1;
   uvec2 bc = uvec2(0u);
   for (uint c = 0u; c < 4u; c++) {
      float u;
      const uint k0 = 2u * c, k1 = 2u * c + 1u;
      bc[k0 >> 2u] |= eq(ER47, e0[c], u) << (8u * (k0 & 3u)); q0[c] = u;
      bc[k1 >> 2u] |= eq(ER47, e1[c], u) << (8u * (k1 & 3u)); q1[c] = u;
   }
   if (dot(q1.rgb, vec3(1.0)) < dot(q0.rgb, vec3(1.0))) {
      const vec4 t = q0; q0 = q1; q1 = t;
      bc = ((bc >> 8u) & 0x00ff00ffu) | ((bc << 8u) & 0xff00ff00u);
   }
   const vec4 d = (q1 - q0) * m0;
   const float rdd = dot(d, d) > 0.0 ? 3.0 / dot(d, d) : 0.0;
   const float da = dot(q1 - q0, m1);
   const float rda = da != 0.0 ? 3.0 / da : 0.0;
   uvec4 w = uvec4(0u);
   for (uint i = 0u; i < 16u; i++) {
      const vec4 p = bc_texel(src, format, i);
      const uint v0 = uint(clamp(dot((p - q0) * m0, d) * rdd + 0.5, 0.0, 3.0));
      const uint v1 = uint(clamp(dot(p - q0, m1) * rda + 0.5, 0.0, 3.0));
      w[i >> 3u] |= (v0 | v1 << 2u) << (4u * (i & 7u));
   }
   uvec4 blk = astc_header(12u, 4u, 0u, true);
   put_endpoints(blk, bc, 8u, ER47);
   put_weights(blk, w);
   put_bits(blk, 128u - 64u - 2u, ccs, 2u);
   return blk;
}

/* ---- BC7 entry -------------------------------------------------------- */

/* Per BC7 block: opaque blocks take one RGB line, modes 4/5 their own
 * endpoints as an exact dual-plane line, mode 6 its endpoints as one RGBA
 * line; only the rare mode 7 runs the full line search. */
uvec4 encode_block(uvec4 src, int format)
{
   bc7_setup(src);
   bool opaque = true;
   for (uint k = 0u; k < 2u * g7_ns; k++)
      opaque = opaque && (g7_ep[k] >> 24u) == 255u;
   if (g7_mode == 5u && opaque && g7_rot == 0u)
      return enc_bc7_m5_opaque(src);
   bc7_cache(src);
   if (opaque && g7_rot == 0u)
      return enc_opaque_fast(src, format);
   if (g7_mode == 4u || g7_mode == 5u)
      return enc_dual_fast(src, format, g7_rot == 0u ? 3u : g7_rot - 1u, true,
                           vec4(bc7_rot_ep(0u)), vec4(bc7_rot_ep(1u)));
   /* Mode 7 (two RGBA subsets, shared weights) is rare but hard: full
    * search, dual plane then single plane. */
   if (g7_mode == 7u) {
      uvec4 blk, cand;
      const float e = enc_line(src, format, 12u, true, WR3, ER47, 1e30, false, vec4(0.0), vec4(0.0), 3u, blk);
      if (e <= 2000.0)
         return blk;
      const float e2 = enc_line(src, format, 12u, false, WR15, ER47, e, false, vec4(0.0), vec4(0.0), 3u, cand);
      return e2 <= e ? cand : blk;
   }
   const bool m6 = g7_mode == 6u;
   return enc_rgba_fast(src, format, m6, m6 ? vec4(bc7_rot_ep(0u)) : vec4(0.0),
                        m6 ? vec4(bc7_rot_ep(1u)) : vec4(0.0));
}

void main()
{
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    uint bz = gl_GlobalInvocationID.z;

    uint num_blocks_x = uint((registers.width + 3) / 4);
    uint num_blocks_y = uint((registers.height + 3) / 4);

    if (bx >= num_blocks_x || by >= num_blocks_y || bz >= uint(registers.depth))
        return;

    InBuf ibuf = InBuf(registers.src);
    OutBuf obuf = OutBuf(registers.dst);
    int format = registers.format;

    uint in_word = (bz * registers.src_slice_B + by * registers.src_row_B) / 4u + bx * 4u;
    uvec4 src = uvec4(ibuf.data[in_word], ibuf.data[in_word + 1u],
                      ibuf.data[in_word + 2u], ibuf.data[in_word + 3u]);

    uvec4 astc = encode_block(src, format);

    uint out_word = registers.dst_tiled != 0u
        ? (bz * registers.dst_slice_B +
           utile_offset_B(registers.dst_x0 + bx, registers.dst_y0 + by, 2u, 16u)) / 4u
        : (bz * registers.dst_slice_B + by * registers.dst_row_B) / 4u + bx * 4u;
    obuf.data[out_word + 0u] = astc.x;
    obuf.data[out_word + 1u] = astc.y;
    obuf.data[out_word + 2u] = astc.z;
    obuf.data[out_word + 3u] = astc.w;
}
