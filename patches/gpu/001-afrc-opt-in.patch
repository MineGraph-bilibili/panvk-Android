# Purpose: PANVK_AFRC=16|24|32 opt-in fixed-rate lossy colour compression (experimental).
#   Application-created colour images that pass the safety filters try an AFRC
#   modifier before the AFBC-first automatic modifier list, which otherwise
#   never selects AFRC.
# Source/Reference: original, written for this repo (no upstream commit);
#   arch/format filters follow panvk_image_get_mod()/pan_image_afrc checks.
# Tested GPU: none yet — build-only validation. Default-off, so the production
#   path is byte-identical to the perf/local series on Mali-G715 (MT6985).
# Tested Kbase UAPI: n/a (image modifier selection, no ioctl changes).
# Mesa base range: 26.3.0-devel (pinned 5a07217f).
# Dependencies: none. Applies on top of the perf/local families in the
#   g615-v11-csf series, but is intentionally absent from SERIES.
# Validation: cross-compiled for v6..v14 (2026-10-25); with PANVK_AFRC unset or
#   0 the modifier selection path is unchanged. 16/24/32 keep the option open;
#   WSI/CRC, sparse, mutable, cube, block-texel, storage and host-transfer
#   images are excluded. No device run yet; enable only for A/B experiments.
#
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -322,6 +322,10 @@
 }
 
 static uint64_t
+panvk_image_try_afrc(struct panvk_image *image,
+                     const struct pan_image_usage *iusage);
+
+static uint64_t
 panvk_image_get_mod(struct panvk_image *image,
                     const VkImageCreateInfo *pCreateInfo)
 {
@@ -351,6 +355,11 @@
    if (iusage.legacy_scanout || image->bc_emul)
       return DRM_FORMAT_MOD_LINEAR;
 
+   /* PANVK_AFRC is an experimental AFRC path, disabled by default. */
+   uint64_t afrc_mod = panvk_image_try_afrc(image, &iusage);
+   if (afrc_mod != DRM_FORMAT_MOD_INVALID)
+      return afrc_mod;
+
    /* Without external dependencies, pick the best modifier that supports the image. */
    return panvk_image_get_mod_from_list(image, &iusage, NULL, 0);
 }
@@ -452,6 +461,74 @@
