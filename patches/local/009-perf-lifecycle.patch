+struct dev_tls_layout {
+   uint64_t span;      /* pan_get_total_stack_size() */
+   uint64_t per_core;  /* bytes per core-ID slot */
+   uint64_t present;   /* shader_present */
+   unsigned range;     /* core-ID range */
+   unsigned thread_size, threads;
+};
