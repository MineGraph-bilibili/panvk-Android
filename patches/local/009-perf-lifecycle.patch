+static uint64_t
+dev_tls_shrink_ns(void)
+{
+   static int v = -1;
+   return (uint64_t)MAX2(dev_tls_knob(&v, "PANVK_TLS_SHRINK_MS", 10000), 0) *
+          1000000ull;
