diff --git a/src/panfrost/compiler/kraid/opt_exec_units.rs b/src/panfrost/compiler/kraid/opt_exec_units.rs
new file mode 100644
index 0000000..dcc9254
--- /dev/null
+++ b/src/panfrost/compiler/kraid/opt_exec_units.rs
@@ -0,0 +1,58 @@
+// Copyright © 2026 Collabora, Ltd.
+// SPDX-License-Identifier: MIT
+
+use crate::data_type::NumericType;
+use crate::ir::*;
+use crate::ops::{CmpOp, MuxOp, OpCSel, OpMux};
+
+/// MUX executes in the SFU unit, while CSEL executes in the CVT unit.  CVT is
+/// always wider than the SFU unit by at least 4x, this is always an optimization.
+fn try_replace_mux_csel(op: &OpMux) -> Option<OpCSel> {
+    if !matches!(op.dst_type, DataType::I32 | DataType::V2I16) {
+        return None;
+    };
+
+    if op.src0.swizzle != Swizzle::NONE
+        || op.src1.swizzle != Swizzle::NONE
+        || op.sel.swizzle != Swizzle::NONE
+    {
+        return None;
+    }
+
+    let (cmp_op, num) = match op.mux_op {
+        MuxOp::Neg => (CmpOp::Ge, NumericType::SignedInteger),
+        MuxOp::IntZero => (CmpOp::Ne, NumericType::SignedInteger),
+        MuxOp::FpZero => (CmpOp::Ne, NumericType::Float),
+        MuxOp::Bit => return None,
+    };
+
+    Some(OpCSel {
+        dst: op.dst.clone(),
+        cmp_type: DataType::get(op.dst_type.comps(), num, op.dst_type.bits()),
+        cmp_op,
+        cmp_srcs: [op.sel.clone(), 0u32.into()],
+        sel_srcs: [op.src1.clone(), op.src0.clone()],
+    })
+}
+
+fn translate_instr(i: &mut Instr) {
+    if let Op::Mux(op) = &mut i.op {
+        if let Some(csel) = try_replace_mux_csel(op) {
+            i.op = csel.into();
+        }
+    }
+}
+
+impl Shader<'_> {
+    /// Tries to replace operations with cheaper, equivalent ones.  The only
+    /// example right now is MUX being replaced with CSEL (SFU -> CVT), we might
+    /// want this list to be expanded in the future.  Must run before
+    /// legalization as we are inserting a 0 source that might conflict with
+    /// other FAUs (in v9-v10).
+    pub fn opt_exec_units(&mut self) {
+        self.map_instrs(|mut i, _| {
+            translate_instr(&mut i);
+            [i].into()
+        });
+    }
+}
diff --git a/src/panfrost/compiler/kraid/opt_fuse.rs b/src/panfrost/compiler/kraid/opt_fuse.rs
new file mode 100644
index 0000000..af792f3
--- /dev/null
+++ b/src/panfrost/compiler/kraid/opt_fuse.rs
@@ -0,0 +1,287 @@
+use crate::ir::*;
+use crate::ops::*;
+use crate::ssa_value::SSAValueIndexedVec;
+
+/// Checks if all sources for the Opcode support swizzles and modifiers
+fn op_supports_srcs(model: &dyn Model, op: &Op) -> bool {
+    op.srcs().iter().all(|src| {
+        model.op_src_supports_swizzle(op, src, src.swizzle)
+            && model.op_src_supports_mod(op, src, src.src_mod)
+    })
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+struct InstrIdx {
+    instr_idx: usize,
+    block_idx: usize,
+}
+
+// Default is OOB (for safety)
+impl Default for InstrIdx {
+    fn default() -> Self {
+        Self {
+            instr_idx: usize::MAX,
+            block_idx: usize::MAX,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct SSAEntry {
+    use_count: u32,
+    def_site: InstrIdx,
+}
+
+struct Fuse {
+    ssa_map: SSAValueIndexedVec<SSAEntry>,
+}
+
+impl Fuse {
+    pub fn new(ssa_count: u32) -> Self {
+        Self {
+            ssa_map: SSAValueIndexedVec::with_count(ssa_count),
+        }
+    }
+
+    pub fn prepass_visit(&mut self, i: &Instr, idx: InstrIdx) {
+        for ssa in i.iter_ssa_uses() {
+            self.ssa_map[ssa].use_count += 1;
+        }
+        for ssa in i.iter_ssa_defs() {
+            debug_assert_eq!(self.ssa_map[ssa].def_site, Default::default());
+            self.ssa_map[ssa].def_site = idx;
+        }
+    }
+
+    /// Get the res_type of the compare instruction
+    fn cmp_res_type(
+        &self,
+        s: &Shader,
+        ssa: SSAValue,
+    ) -> Option<(CmpResultType, u8)> {
+        let entry = &self.ssa_map[ssa];
+        let def = entry.def_site;
+        let i = &s.blocks[def.block_idx].instrs[def.instr_idx];
+
+        if let Op::Cmp(f) = &i.op {
+            Some((f.res_type, f.src_type.bits()))
+        } else {
+            None
+        }
+    }
+
+    /// Returns a FCmp/ICmp entry only when its result is used once
+    fn get_foldable_cmp<'a>(
+        &self,
+        s: &'a Shader,
+        ssa: SSAValue,
+    ) -> Option<&'a OpCmp> {
+        let entry = &self.ssa_map[ssa];
+
+        if entry.use_count != 1 {
+            return None;
+        }
+
+        let def = entry.def_site;
+        let i = &s.blocks[def.block_idx].instrs[def.instr_idx];
+
+        let Op::Cmp(cmp) = &i.op else {
+            return None;
+        };
+
+        debug_assert!(cmp.res_type != CmpResultType::C);
+        debug_assert!(cmp.src_type.bits() <= 32);
+
+        Some(cmp.as_ref())
+    }
+
+    // y.h0 = FCMP.v2f16.lt.m1 x 0
+    // DISCARD.f32.ne y.h0 0
+    //      =>
+    // DISCARD.f32.lt x.h0 0
+    fn fuse_discard(&self, s: &Shader, op: &OpDiscard) -> Option<Op> {
+        let cond_src = if op.srcs[0].is_zero() {
+            &op.srcs[1]
+        } else if op.srcs[1].is_zero() {
+            &op.srcs[0]
+        } else {
+            return None;
+        };
+        if op.cmp_op != CmpOp::Ne || !cond_src.src_mod.is_none() {
+            return None;
+        }
+
+        let SrcRef::SSA(cond_vec) = &cond_src.src_ref else {
+            return None;
+        };
+        debug_assert_eq!(cond_vec.len(), 1);
+        let cond_ssa = cond_vec[0];
+
+        let cmp = self.get_foldable_cmp(s, cond_ssa)?;
+        if !cmp.src_type.is_float_type() || cmp.accum_op != CmpAccumOp::None {
+            return None;
+        }
+
+        let srcs = if cond_ssa.bits() == 16 {
+            if !op.srcs[0].swizzle.is_f16_widen() || cmp.src_type.bits() != 16 {
+                return None;
+            }
+
+            cmp.srcs.clone().map(|x| x.swizzle(op.srcs[0].swizzle))
+        } else {
+            if !op.srcs[0].swizzle.is_none() || cmp.src_type.bits() != 32 {
+                return None;
+            }
+            cmp.srcs.clone()
+        };
+
+        Some(Op::from(OpDiscard {
+            cmp_op: cmp.cmp_op,
+            srcs,
+        }))
+    }
+
+    // c = FCMP.f32.lt a, b
+    // d = MUX.i32.int_zero y, x, c
+    //      =>
+    // d = CSEL.f32.lt a, b, x, y
+    // This actually upsets the spiller, presumably because we increase the max
+    // register pressure.  It is still a (small) win with small shaders though
+    fn fuse_mux_csel(&self, s: &Shader, mux: &OpMux) -> Option<Op> {
+        if mux.mux_op != MuxOp::IntZero || !mux.sel.src_mod.is_none() {
+            return None;
+        }
+        debug_assert!(mux.dst_type.total_bits() <= 32);
+
+        let SrcRef::SSA(sel_ssa) = &mux.sel.src_ref else {
+            return None;
+        };
+        let sel_ssa = sel_ssa[0];
+        let cmp = self.get_foldable_cmp(s, sel_ssa)?;
+        if cmp.accum_op != CmpAccumOp::None
+            || cmp.src_type.bits() != mux.dst_type.bits()
+        {
+            return None;
+        }
+
+        let cmp_srcs = cmp.srcs.clone().map(|x| x.swizzle(mux.sel.swizzle));
+        let op = OpCSel {
+            dst: mux.dst.clone(),
+            cmp_type: cmp.src_type,
+            cmp_op: cmp.cmp_op,
+            cmp_srcs,
+            sel_srcs: [mux.src1.clone(), mux.src0.clone()],
+        };
+
+        if !op.is_valid_variant(op.cmp_type) {
+            return None;
+        }
+        Some(op.into())
+    }
+
+    // c = FCMP.f32.lt a, b
+    // f = FCMP.f32.lt d, e
+    // g = OR c, d
+    //      =>
+    // c = FCMP.f32.lt a, b
+    // g = FCMP_OR.f32.lt d, e, c
+    fn fuse_shift_lop_accum(&self, s: &Shader, lop: &OpShiftLop) -> Option<Op> {
+        if lop.not_result
+            || lop.shift_op != ShiftOp::None
+            || lop.dst_type.total_bits() > 32
+        {
+            return None;
+        }
+
+        let accum_op = match lop.logic_op {
+            LogicOp::And => CmpAccumOp::And,
+            LogicOp::Or => CmpAccumOp::Or,
+            _ => return None,
+        };
+
+        let src0_ssa = lop.src0.as_ssa()?[0];
+        let src2_ssa = lop.src2.as_ssa()?[0];
+
+        let no_accum = |x: &&OpCmp| x.accum_op == CmpAccumOp::None;
+        let (cmp_entry, accum_src) = if let Some(cmp) =
+            self.get_foldable_cmp(s, src0_ssa).filter(no_accum)
+        {
+            (cmp, src2_ssa)
+        } else if let Some(cmp) =
+            self.get_foldable_cmp(s, src2_ssa).filter(no_accum)
+        {
+            (cmp, src0_ssa)
+        } else {
+            return None;
+        };
+
+        // Check if the other source is a cmp-result with the same type
+        if (cmp_entry.res_type, cmp_entry.src_type.bits())
+            != self.cmp_res_type(s, accum_src)?
+        {
+            return None;
+        }
+
+        Some(Op::from(OpCmp {
+            dst: lop.dst.clone(),
+            src_type: cmp_entry.src_type,
+            res_type: cmp_entry.res_type,
+            cmp_op: cmp_entry.cmp_op,
+            srcs: cmp_entry.srcs.clone(),
+            accum: accum_src.into(),
+            accum_op,
+        }))
+    }
+
+    pub fn visit(&self, s: &Shader, i: &Instr) -> Option<Op> {
+        match &i.op {
+            Op::Discard(op) => self.fuse_discard(s, op),
+            Op::Mux(op) => self.fuse_mux_csel(s, op),
+            Op::ShiftLop(op) => self.fuse_shift_lop_accum(s, op),
+            _ => None,
+        }
+    }
+}
+
+/// Fuses instruction sequences into equivalent but shorter ones
+///
+/// Many instructions can do an "implicit" AND X, OR X. For example:
+/// FCMP.ge.or A B ACCUM.  This pass fuses (OR (FCMP A B) ACCUM) into
+/// (FCMP_OR A B ACCUM).
+///
+/// TODO: Fuse BRANCH + CMP.ne (+ swizzles?)
+/// TODO: Unit tests
+impl Shader<'_> {
+    pub fn opt_fuse(&mut self) -> bool {
+        let mut ctx = Fuse::new(self.ssa_alloc.count());
+
+        // Pass 1: gather SSA use_count and def_site
+        for (block_idx, block) in self.blocks.iter().enumerate() {
+            for (instr_idx, instr) in block.instrs.iter().enumerate() {
+                let idx = InstrIdx {
+                    instr_idx,
+                    block_idx,
+                };
+                ctx.prepass_visit(instr, idx);
+            }
+        }
+
+        // Pass 2: actual fusions
+        let mut progress = false;
+        for block_idx in 0..self.blocks.len() {
+            for instr_idx in 0..self.blocks[block_idx].instrs.len() {
+                let i = &self.blocks[block_idx].instrs[instr_idx];
+                let repl = ctx
+                    .visit(self, i)
+                    .filter(|op| op_supports_srcs(self.model, op));
+                let Some(repl_op) = repl else {
+                    continue;
+                };
+                progress = true;
+                // No need to update the prepass map
+                self.blocks[block_idx].instrs[instr_idx].op = repl_op;
+            }
+        }
+        progress
+    }
+}
diff --git a/src/panfrost/compiler/kraid/opt_normalize_consts.rs b/src/panfrost/compiler/kraid/opt_normalize_consts.rs
new file mode 100644
index 0000000..3f18939
--- /dev/null
+++ b/src/panfrost/compiler/kraid/opt_normalize_consts.rs
@@ -0,0 +1,459 @@
+// Copyright © 2026 Arm Ltd.
+// SPDX-License-Identifier: MIT
+
+use crate::{ir::*, swizzle::AsmSwizzleWiden};
+use compiler::{enum_as_u8::EnumAsU8, float16::F16};
+
+fn get_other_variants(op: &Op) -> &[DataType] {
+    use DataType::*;
+
+    match op.variant() {
+        Some(V4I8) => &[V4U8, V4S8],
+        Some(V2I16) => &[V2U16, V2S16],
+        Some(I32) => &[U32, S32],
+        Some(I64) => &[U64, S64],
+        _ => &[],
+    }
+}
+
+#[derive(PartialEq)]
+struct SupportedSwizzle {
+    swz: Swizzle,
+    variant: Option<DataType>,
+}
+
+impl SupportedSwizzle {
+    const HF0: Self = SupportedSwizzle {
+        swz: Swizzle::HF0,
+        variant: Some(DataType::F32),
+    };
+}
+
+impl std::fmt::Display for SupportedSwizzle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        if let Some(variant) = self.variant {
+            write!(f, "({},{})", self.swz, variant)
+        } else {
+            write!(f, "({},None)", self.swz)
+        }
+    }
+}
+
+fn supported_swizzles(
+    model: &dyn Model,
+    op: &mut Op,
+    src_idx: usize,
+    out: &mut Vec<SupportedSwizzle>,
+) {
+    out.clear();
+
+    let base_variant = op.variant();
+    let other_variants: Vec<_> = get_other_variants(op)
+        .iter()
+        .filter(|v| op.is_valid_variant(**v))
+        .map(|v| Some(*v))
+        .collect();
+    let variants =
+        std::iter::once(base_variant).chain(other_variants.into_iter());
+
+    for variant in variants {
+        if let Some(variant) = variant {
+            op.set_variant(variant);
+        }
+        let src = &op.srcs()[src_idx];
+        for swz in model.op_src_supported_swizzles(op, src).iter() {
+            if swz == AsmSwizzleWiden::None {
+                continue;
+            }
+            let Some(swz) = swz.to_swizzle(op.src_type(src)) else {
+                continue;
+            };
+
+            out.push(SupportedSwizzle { swz, variant });
+        }
+    }
+
+    if let Some(variant) = base_variant {
+        op.set_variant(variant);
+    }
+}
+
+fn supported_mods(
+    model: &dyn Model,
+    op: &Op,
+    src_idx: usize,
+    out: &mut Vec<SrcMod>,
+) {
+    out.clear();
+    let src = &op.srcs()[src_idx];
+    for m in SrcMod::VARIANTS.iter() {
+        if model.op_src_supports_mod(op, src, m) {
+            out.push(m);
+        }
+    }
+}
+
+fn try_f32_as_f16(v: f32) -> Option<F16> {
+    let half = F16::from_f32_rtne(v);
+    let widened = Swizzle::HF0.fold_u32(half.to_bits() as u32).unwrap();
+
+    if widened == v.to_bits() {
+        Some(half)
+    } else {
+        None
+    }
+}
+
+#[derive(Debug, PartialEq)]
+struct SqueezedImm {
+    imm: u32,
+    swz: Swizzle,
+    variant: Option<DataType>,
+}
+
+fn squeeze_imm(
+    src: &Src,
+    swizzles: &[SupportedSwizzle],
+    src_type: DataType,
+) -> Option<SqueezedImm> {
+    let mut tmp_src = src.clone();
+    tmp_src.src_mod = SrcMod::None;
+    let Some(swizzled) = tmp_src.resolve_imm(src_type) else {
+        return None;
+    };
+
+    if src_type.is_float_type() && swizzles.contains(&SupportedSwizzle::HF0) {
+        assert!(src_type == DataType::F32);
+        assert!((swizzled & 0xffff_ffff << 32) == 0);
+
+        if let Some(half) = try_f32_as_f16(f32::from_bits(swizzled as u32)) {
+            return Some(SqueezedImm {
+                imm: half.to_bits() as u32,
+                swz: Swizzle::HF0,
+                variant: None, // we never want to change the variant of f32.
+            });
+        }
+    } else if src_type.is_any_int_type() {
+        // For replication, all components are the same, try the lowest one.
+        // For a widen, the higher bytes just contain 0x00 or 0xff.
+        let ok_bytes_read = [0b1, 0b11, 0b1111];
+        let mut best_read = src.swizzle.bytes_read(src_type.total_bytes());
+        let mut best_squeezed = None;
+
+        for SupportedSwizzle { swz, variant } in swizzles {
+            let bytes_read = swz.bytes_read(src_type.total_bytes());
+            if bytes_read >= best_read || !ok_bytes_read.contains(&bytes_read) {
+                continue;
+            }
+
+            let read_mask = swz.bits_read(src_type.total_bytes());
+            let try_imm: u32 = (swizzled & read_mask).try_into().unwrap();
+
+            let Some(resolved) =
+                Src::from(try_imm).swizzle(*swz).resolve_imm(src_type)
+            else {
+                continue;
+            };
+            if resolved == swizzled {
+                best_read = bytes_read;
+                best_squeezed = Some(SqueezedImm {
+                    imm: try_imm,
+                    swz: *swz,
+                    variant: *variant,
+                });
+            }
+
+            // Stop if we can't do better.
+            if best_read == 0b1 {
+                break;
+            }
+        }
+
+        return best_squeezed;
+    }
+
+    None
+}
+
+fn normalize_neg(src: &mut Src, mods: &[SrcMod], src_type: DataType) {
+    let SrcRef::Imm32(imm32) = &src.src_ref else {
+        return;
+    };
+    let imm32 = u32::from(*imm32);
+
+    let Some(swizzled) =
+        Src::from(imm32).swizzle(src.swizzle).resolve_imm(src_type)
+    else {
+        return;
+    };
+
+    // Check if the most significant bit read from the imm is set.
+    // This means a negative value for signed int and float, and is a reasonable choice for
+    // unsigned.
+    let bytes_read = src.swizzle.bytes_read(src_type.total_bytes());
+    if bytes_read == 0 {
+        return;
+    }
+    let highest_byte_read = 7 - bytes_read.leading_zeros();
+    let check_bit = 0x80u64 << (8 * highest_byte_read);
+
+    if ((imm32 as u64) & check_bit) == 0 {
+        return;
+    }
+    let try_mod = if src_type.is_float_type() {
+        SrcMod::FNeg
+    } else {
+        SrcMod::BNot
+    };
+    if !mods.contains(&try_mod) {
+        return;
+    }
+
+    let imm32_modified = match src.swizzle {
+        // If we widen from the lower half to f32, folding with f32 flips the wrong bit.
+        Swizzle::HF0 => try_mod.fold_u32(DataType::F16, imm32).unwrap(),
+        _ => try_mod.fold_u32(src_type, imm32).unwrap(),
+    };
+
+    let resolved = Src::from(imm32_modified)
+        .swizzle(src.swizzle)
+        .modify(try_mod)
+        .resolve_imm(src_type);
+    if resolved == Some(swizzled) {
+        // For FADD.v2f16 _ 0xbc00.h00            we do not want
+        //     FADD.v2f16 _ 0x80003c00.h00.fneg   as the result but
+        //     FADD.v2f16 _ 0x3c00.h00.fneg
+        // so mask away the bits we don't read anyways.
+        let imm32_modified = imm32_modified
+            & src.swizzle.bits_read(src_type.total_bytes()) as u32;
+
+        src.src_ref = imm32_modified.into();
+        src.src_mod = try_mod.modify(src.src_mod);
+    }
+}
+
+fn normalize_consts_instr(
+    instr: &mut Instr,
+    swizzles: &mut Vec<SupportedSwizzle>,
+    mods: &mut Vec<SrcMod>,
+    model: &dyn Model,
+) {
+    for src_idx in 0..instr.srcs().len() {
+        if !matches!(&instr.srcs()[src_idx].src_ref, SrcRef::Imm32(_)) {
+            continue;
+        }
+
+        supported_swizzles(model, &mut instr.op, src_idx, swizzles);
+
+        let (src, src_type) = instr.op.srcs_types().nth(src_idx).unwrap();
+        if let Some(si) = squeeze_imm(src, &swizzles, src_type) {
+            let src = &mut instr.op.srcs_mut()[src_idx];
+            src.swizzle = si.swz;
+            src.src_ref = si.imm.into();
+            if let Some(variant) = si.variant {
+                instr.set_variant(variant);
+            }
+        }
+
+        supported_mods(model, &instr.op, src_idx, mods);
+        let (src, src_type) = instr.op.srcs_types_mut().nth(src_idx).unwrap();
+        normalize_neg(src, &mods, src_type);
+    }
+}
+
+fn normalize_consts(s: &mut Shader) {
+    let mut swizzles = Default::default();
+    let mut mods = Default::default();
+
+    let instrs = s.blocks.iter_mut().flat_map(|b| b.instrs.iter_mut());
+
+    for instr in instrs {
+        normalize_consts_instr(instr, &mut swizzles, &mut mods, s.model);
+    }
+}
+
+impl Shader<'_> {
+    pub fn opt_normalize_consts(&mut self) {
+        normalize_consts(self);
+    }
+}
