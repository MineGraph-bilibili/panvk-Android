    if (chunk_addr) {
       cs_move64_to(compute, addr, chunk_addr);
       cs_load32_to(compute, value, addr, 0);
@@ -6723,12 +6726,6 @@ draw_batch_state_ok(struct panvk_cmd_buffer *cmdbuf)
    if (gfx->gs.shader || gfx->tes.shader)
