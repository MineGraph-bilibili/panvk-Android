+       cmdbuf->state.gfx.ib.index_size == index_size)
+      return;
+
+#if PAN_ARCH >= 10
+   panvk_per_arch(cmd_draw_batch_flush)(cmdbuf);
+#endif
+
+   cmdbuf->state.gfx.ib.size = range;
+   cmdbuf->state.gfx.ib.dev_addr = dev_addr;
+   cmdbuf->state.gfx.ib.index_size = index_size;
