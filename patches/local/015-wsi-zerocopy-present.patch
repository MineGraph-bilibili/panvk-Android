+      panvk_android_anw_wait_fence(fence_fd);
+      chain->images[idx].held = true;
+      chain->next_image = (idx + 1) % chain->base.image_count;
+      *image_index = (uint32_t)idx;
+      return VK_SUCCESS;
+   }
+
+   return VK_ERROR_OUT_OF_DATE_KHR;
 }
 
