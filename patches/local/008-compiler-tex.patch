+
+void
+pan_stats_verbose_epilogue(FILE *f, const struct pan_shader_info *info)
+{
+   fprintf(f, "\n");
+   fprintf(f, "Shader properties\n");
+   fprintf(f, "=================\n");
+   fprintf(f, "Contains barrier: %s\n", bool_str(info->contains_barrier));
