+      fprintf(f, "Reads color buffer: %s\n", bool_str(info->fs.outputs_read != 0));
+      break;
+   default:
+      break;
+   }
+   fprintf(f, "\n");
+}
+
+void
+pan_valhall_stats_verbose(FILE *f, const struct valhall_stats *stats,
