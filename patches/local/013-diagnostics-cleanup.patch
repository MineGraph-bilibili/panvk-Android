+   }
+   if (import_probe_img_count < 8)
+      import_probe_imgs[import_probe_img_count++] = img;
+   PANVK_DIAG_PRINTF("[PANVK-DIAG] present IMAGE bound: img=%p bo=%p count=%u\n",
+                     (void *)img, bo, import_probe_img_count);
+}
